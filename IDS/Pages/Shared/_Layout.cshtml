@inject IDS.Security.SecurityPolicyService SecurityPolicies
@{
    var messagingEnabled = User?.Identity?.IsAuthenticated == true && (await SecurityPolicies.GetAsync()).MessagingEnabled;
}
<!DOCTYPE html>
<html lang="en" data-authenticated="@(User?.Identity?.IsAuthenticated == true ? "true" : "false")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDS Security</title>
    
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/session-history.js" asp-append-version="true" defer></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo16qeRvEALZy9FTgvLqjAZaFJ0cJTgLJhLdJvMA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-approvals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IDS.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("HeadContent", required: false)
</head>
<body class="app-shell">
 <a class="visually-hidden-focusable app-skip-link" href="#main-content">Skip to main content</a>
 <header>
  <nav class="navbar navbar-ids navbar-expand-lg">
    <div class="container-fluid px-4">
         <a class="navbar-brand" asp-area="" asp-page="/Index">
<i class="fa-solid fa-shield-halved"></i>
      IDS Security
            </a>
   
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
 </button>
                
<div class="navbar-collapse collapse" id="navbarMain">
       <ul class="navbar-nav me-auto">
@if (User?.Identity?.IsAuthenticated == true)
       {
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Dashboard" ? "active" : "")" asp-area="" asp-page="/Dashboard">
    <i class="fa-solid fa-gauge me-1"></i> Dashboard
  </a>
          </li>
  
<!-- Live Dashboard Link -->
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/LiveDashboard" ? "active" : "")" asp-area="" asp-page="/LiveDashboard">
  <i class="fa-solid fa-satellite-dish me-1"></i> Live Feed
    </a>
</li>

@if (messagingEnabled)
{
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Chat" ? "active" : "")"
           asp-area="" asp-page="/Chat">
            <i class="fa-solid fa-comments me-1"></i> Messages
        </a>
    </li>
}

   @if (User.IsInRole("Admin"))
       {
          <li class="nav-item dropdown">
              <button class="nav-link dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="fa-solid fa-user-shield me-1" aria-hidden="true"></i> Administration
              </button>
              <div class="dropdown-menu">
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/Operations">Settings</a>
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/Security">Security approvals</a>
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/UserList">Employees and roles</a>
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/Alerts">Security alerts</a>
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/DatabaseViewer">Database</a>
                  <a class="dropdown-item" asp-area="" asp-page="/Admin/Logs">Audit and logs</a>
              </div>
          </li>
      }
    
        @* Support Tickets - visible to Admin and Support roles *@
              @if (User.IsInRole("Admin") || User.IsInRole("Support"))
     {
           <li class="nav-item">
 <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Support/") == true ? "active" : "")" asp-area="" asp-page="/Support/Tickets">
          <i class="fa-solid fa-headset me-1"></i> Support Tickets
        </a>
             </li>
       }
    
        @* Submit Ticket - visible to all authenticated users *@
     <li class="nav-item">
      <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/SubmitTicket" || ViewContext.RouteData.Values["page"]?.ToString() == "/ViewTicket" ? "active" : "")" asp-area="" asp-page="/SubmitTicket">
  <i class="fa-solid fa-ticket me-1"></i> My Tickets
      </a>
   </li>
    }
else
        {
             <li class="nav-item">
   <a class="nav-link" asp-area="" asp-page="/Index">
     <i class="fa-solid fa-home me-1"></i> Home
  </a>
         </li>
            }
       
         <li class="nav-item">
     <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Help" ? "active" : "")" asp-area="" asp-page="/Help">
        <i class="fa-solid fa-circle-question me-1"></i> Help
         </a>
  </li>
 </ul>
   
    <div class="d-flex flex-wrap align-items-center gap-2">
    <!-- Theme Toggle -->
  <button id="themeToggle" type="button" class="btn btn-icon btn-ids-ghost" aria-label="Toggle theme" title="Toggle dark/light mode">
  <i class="fa-solid fa-moon" id="themeIcon" aria-hidden="true"></i>
       </button>
          
 @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
 {
     <partial name="_ApprovalNotifications" />
 }
 @if (User?.Identity?.IsAuthenticated == true)
 {
     <partial name="_InboxNotifications" />
 }
 <partial name="_LoginPartial" />
   </div>
  </div>
            </div>
</nav>
  </header>

    @{
        var fullWidth = ViewData["FullWidthLayout"] != null || ViewData["NoContainer"] != null;
    }
    <main id="main-content" class="@(fullWidth ? "main-content-full" : "main-content")">
        @if (fullWidth)
        {
            @RenderBody()
        }
        else
        {
            <div class="container-fluid app-container">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="footer-ids">
  <div class="container">
       <span>&copy; @DateTime.Now.Year IDS Security System</span>
 <span class="mx-2">|</span>
        <a href="/Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
  </div>
</footer>

 <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <script src="~/js/admin-approvals.js" asp-append-version="true" defer></script>
    }
    @if (messagingEnabled)
    {
        <script src="~/js/chat-notifications.js" asp-append-version="true" defer></script>
    }
    

 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
