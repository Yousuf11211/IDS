@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
    ViewData["NoContainer"] = true;
}

<div class="login-page" style="background: var(--bg-primary);">
    <div class="login-container" style="max-width: 500px;">
  <div class="card-ids text-center">
    <div class="card-ids-body py-5">
     <div class="mb-4">
  <i class="fa-solid fa-ban" style="font-size: 4rem; color: var(--danger);"></i>
    </div>
    <h1 class="h3 mb-3">Access Denied</h1>
      <p class="text-muted mb-4">
You do not have permission to access this resource.
     </p>
  
 <div class="alert-ids alert-ids-warning mb-4">
 <i class="alert-ids-icon fa-solid fa-exclamation-triangle"></i>
     <div class="alert-ids-content">
  If you believe this is an error, please contact your system administrator.
   </div>
   </div>
 
      <div class="d-flex gap-3 justify-content-center">
      <a href="/Dashboard" class="btn-ids btn-ids-primary">
     <i class="fa-solid fa-gauge me-2"></i> Go to Dashboard
   </a>
      <a href="javascript:history.back()" class="btn-ids btn-ids-secondary">
     <i class="fa-solid fa-arrow-left me-2"></i> Go Back
   </a>
     </div>
    </div>
 </div>
  </div>
</div>
