@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Choose a password";
}
<section class="card-ids card-ids-body mx-auto" style="max-width: 36rem">
    <h1 class="h3">Choose a password</h1>
    <form method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />
        <input asp-for="Input.Mode" type="hidden" />
        @if (!string.IsNullOrEmpty(Model.Input.Code))
        {
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Registered email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="email" />
            </div>
            @if (Model.Input.Mode != null)
            {
                <div class="mb-3">
                    <label asp-for="Input.Factor" class="form-label"></label>
                    <input asp-for="Input.Factor" class="form-control" autocomplete="one-time-code" />
                    <div class="form-text">Required when your account has an active authenticator.</div>
                    <label class="form-check mt-2"><input asp-for="Input.UseRecoveryCode" class="form-check-input" /> Use a recovery code</label>
                </div>
            }
            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">New password</label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            </div>
            <button type="submit" class="btn-ids btn-ids-primary">Save password</button>
        }
    </form>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <a asp-page="./ForgotPassword">Request a new link</a>
        <a asp-page="./AuthenticatorRecovery">Request authenticator reset</a>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
