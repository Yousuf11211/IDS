# IDS Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# Admin User Credentials (used for seeding)
# ==============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# ==============================================
# Mailjet Email Configuration
# ==============================================
# Mailjet API credentials (get from https://app.mailjet.com/account/apikeys)
MAILJET_API_KEY=b5dc345c020f6bc2e212fe9836fee657
MAILJET_SECRET_KEY=9b7da36b559a1dab35d5e0843660cac7

# SMTP settings (fixed for Mailjet - do not change)
MAILJET_SMTP_SERVER=in-v3.mailjet.com
MAILJET_SMTP_PORT=587

# Sender info (must be validated domain in Mailjet)
MAILJET_FROM_EMAIL=no-reply@intrusiondetectionsystem.great-site.net
MAILJET_FROM_NAME=IDS System

# Toggle email sending: true = send emails, false = skip (for dev/testing)
# When false, emails will be logged to console instead of sent
EMAIL_STATUS=true

# Support email shown in email templates
SUPPORT_EMAIL=support@intrusiondetectionsystem.great-site.net

# ==============================================
# Security Configuration
# ==============================================
# WARNING: Set to 'true' ONLY for development/local testing if you have firewall/SSL issues.
# Set to 'false' in production. Bypassing SSL checks exposes you to Man-in-the-Middle attacks.
MAILJET_IGNORE_CERTIFICATE_ERRORS=true

# ==============================================
# Database Connection
# ==============================================
# Optional - defaults to appsettings.json if not set
# CONNECTION_STRING=Server=localhost;Database=IDS;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
