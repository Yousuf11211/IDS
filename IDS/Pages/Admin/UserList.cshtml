@page
@model IDS.Pages.Admin.UserListModel
@{
 ViewData["Title"] = "Manage Users";
}

<div class="page-header">
 <div class="page-header-hero">
        <h1 class="page-header-title">
  <i class="fa-solid fa-users"></i>
  User Management
        </h1>
    <p class="page-header-subtitle">
       Manage user accounts, roles, and permissions for the IDS system.
        </p>
        <div class="page-header-actions">
 <a asp-page="/Admin/CreateUser" class="btn-ids btn-ids-primary" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);">
   <i class="fa-solid fa-user-plus"></i> Create New User
            </a>
      </div>
  </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-ids @(Model.StatusMessage.Contains("Error") || Model.StatusMessage.Contains("Invalid") ? "alert-ids-danger" : "alert-ids-success") mb-4">
     <i class="alert-ids-icon fa-solid @(Model.StatusMessage.Contains("Error") || Model.StatusMessage.Contains("Invalid") ? "fa-circle-xmark" : "fa-circle-check")"></i>
        <div class="alert-ids-content">@Model.StatusMessage</div>
    </div>
}

<!-- Filters -->
<div class="card-ids mb-4">
    <div class="card-ids-body">
  <form method="get" class="row g-3 align-items-end">
  <div class="col-md-4">
       <label class="form-label-ids">Filter by Role</label>
    <select name="role" class="form-control-ids form-select-ids">
         <option value="">All Roles</option>
    @foreach (var r in Model.AllRoles)
           {
        <option value="@r" selected="@(Request.Query["role"] == r)">@r</option>
   }
   </select>
 </div>
   <div class="col-md-4">
<label class="form-label-ids">Search</label>
  <input type="text" name="search" value="@Request.Query["search"]" class="form-control-ids" placeholder="Search by email...">
     </div>
     <div class="col-md-4 d-flex gap-2">
 <button type="submit" class="btn-ids btn-ids-primary">
<i class="fa-solid fa-filter"></i> Apply Filter
        </button>
         <a href="/Admin/UserList" class="btn-ids btn-ids-secondary">
 <i class="fa-solid fa-times"></i> Clear
 </a>
       </div>
     </form>
</div>
</div>

<!-- User Stats -->
<div class="metrics-grid mb-4">
    <div class="metric-card" style="--metric-accent: var(--primary);">
        <div class="metric-icon gradient-blue">
 <i class="fa-solid fa-users"></i>
   </div>
        <div class="metric-content">
       <div class="metric-label">Total Users</div>
      <div class="metric-value">@Model.Users.Count</div>
    </div>
 </div>
    <div class="metric-card" style="--metric-accent: #7c3aed;">
 <div class="metric-icon gradient-purple">
<i class="fa-solid fa-user-shield"></i>
        </div>
  <div class="metric-content">
      <div class="metric-label">Administrators</div>
   <div class="metric-value">@Model.Users.Count(u => u.CurrentRole == "Admin")</div>
   </div>
    </div>
    <div class="metric-card" style="--metric-accent: var(--info);">
     <div class="metric-icon gradient-cyan">
   <i class="fa-solid fa-user-tie"></i>
  </div>
    <div class="metric-content">
  <div class="metric-label">Employees</div>
    <div class="metric-value">@Model.Users.Count(u => u.CurrentRole == "Employee")</div>
  </div>
    </div>
 <div class="metric-card" style="--metric-accent: var(--danger);">
     <div class="metric-icon gradient-red">
 <i class="fa-solid fa-user-slash"></i>
        </div>
        <div class="metric-content">
       <div class="metric-label">Suspended</div>
  <div class="metric-value">@Model.Users.Count(u => u.CurrentRole == "Suspended")</div>
     </div>
    </div>
</div>

<!-- Users Table -->
<div class="card-ids">
    <div class="card-ids-header">
        <h3 class="card-ids-title">
 <i class="fa-solid fa-list text-info"></i>
      User List
        <span class="badge bg-primary ms-2">@Model.Users.Count users</span>
 </h3>
    </div>
 <div class="card-ids-body p-0">
  @if (Model.Users.Any())
        {
       <div style="overflow-x: auto;">
       <table class="table-ids">
   <thead>
      <tr>
<th style="width: 60px;">Avatar</th>
<th>User</th>
<th style="width: 120px;">Role</th>
  <th style="width: 280px;">Change Role</th>
 <th style="width: 100px;">Actions</th>
 </tr>
     </thead>
     <tbody>
     @foreach (var u in Model.Users)
    {
          var roleClass = u.CurrentRole?.ToLowerInvariant() switch
   {
  "admin" => "role-admin",
"employee" => "role-employee",
       "suspended" => "role-suspended",
      _ => "role-unknown"
      };
   var rowClass = u.CurrentRole == "Suspended" ? "row-danger" : "";
    var initials = !string.IsNullOrEmpty(u.FirstName) 
    ? $"{u.FirstName.FirstOrDefault()}{u.LastName?.FirstOrDefault()}"
 : u.Email.FirstOrDefault().ToString();
 <tr class="@rowClass">
        <td>
    <div class="user-avatar" style="width: 36px; height: 36px; font-size: 0.75rem; margin: 0;">
           @initials.ToUpper()
    </div>
  </td>
<td>
 <div>
      <strong>@(!string.IsNullOrEmpty(u.FirstName) ? $"{u.FirstName} {u.LastName}" : u.Email)</strong>
 </div>
   <small class="text-muted">@u.Email</small>
      </td>
 <td>
   <span class="role-badge @roleClass">@(!string.IsNullOrEmpty(u.CurrentRole) ? u.CurrentRole : "None")</span>
     </td>
      <td>
   <form method="post" asp-page-handler="SetRole" class="d-flex gap-2">
      <input type="hidden" name="userId" value="@u.Id" />
     <select name="role" class="form-control-ids form-select-ids" style="max-width: 150px; padding: 0.4rem 2rem 0.4rem 0.6rem;">
       @foreach (var r in Model.AllRoles)
        {
 <option value="@r" selected="@(string.Equals(r, u.CurrentRole, StringComparison.OrdinalIgnoreCase))">@r</option>
      }
   </select>
<button type="submit" class="btn-ids btn-ids-primary btn-ids-sm">
 Update
</button>
      </form>
       </td>
  <td>
    <form method="post" asp-page-handler="DeleteUser" style="display:inline;" 
  onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
   <input type="hidden" name="userId" value="@u.Id" />
   <button type="submit" class="btn-ids btn-ids-danger btn-icon btn-icon-sm" title="Delete User">
          <i class="fa-solid fa-trash"></i>
         </button>
    </form>
       </td>
   </tr>
  }
       </tbody>
         </table>
            </div>
        }
        else
 {
            <div class="empty-state">
  <i class="empty-state-icon fa-solid fa-users-slash"></i>
  <h4 class="empty-state-title">No Users Found</h4>
         <p class="empty-state-text">No users match your current filters.</p>
     <a asp-page="/Admin/CreateUser" class="btn-ids btn-ids-primary">
    <i class="fa-solid fa-user-plus"></i> Create First User
       </a>
  </div>
     }
    </div>
</div>