@page
@model IDS.Pages.Admin.DatabaseViewerModel
@{
    ViewData["Title"] = "Database Viewer";
}

<div class="page-header">
    <div class="page-header-hero">
        <h1 class="page-header-title">
  <i class="fa-solid fa-database"></i>
 Database Viewer
        </h1>
        <p class="page-header-subtitle">
       Review database records. Test data changes require an explicit development setting.
        </p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert-ids @(Model.StatusMessage.Contains("Error") ? "alert-ids-danger" : "alert-ids-success") mb-4">
        <i class="alert-ids-icon fa-solid @(Model.StatusMessage.Contains("Error") ? "fa-circle-xmark" : "fa-circle-check")"></i>
        <div class="alert-ids-content">@Model.StatusMessage</div>
  </div>
}

<div class="row g-4">
    <!-- Table List Sidebar -->
    <div class="col-lg-3">
        <div class="card-ids">
     <div class="card-ids-header">
    <h3 class="card-ids-title">
    <i class="fa-solid fa-table text-primary"></i>
     Tables
                </h3>
            </div>
  <div class="card-ids-body p-0">
                <nav class="sidebar-nav">
       @foreach (var table in Model.AvailableTables)
        {
   var isActive = Model.SelectedTable == table;
           <a href="?table=@table" class="sidebar-nav-link @(isActive ? "active" : "")" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color);">
         <i class="fa-solid @GetTableIcon(table)"></i>
   @table
    <span class="ms-auto badge bg-secondary">@Model.TableRowCounts.GetValueOrDefault(table, 0)</span>
    </a>
              }
       </nav>
         </div>
  </div>
        
   <div class="card-ids mt-4">
       <div class="card-ids-header">
<h3 class="card-ids-title">
    <i class="fa-solid fa-warning text-warning"></i>
    Warning
     </h3>
     </div>
    <div class="card-ids-body">
       <p class="text-muted mb-0" style="font-size: 0.875rem;">
           This view is read-only by default. Data changes can be enabled for approved development environments.
       </p>
       </div>
     </div>
    </div>
    
    <!-- Table Content -->
 <div class="col-lg-9">
        @if (!string.IsNullOrEmpty(Model.SelectedTable))
  {
            <div class="card-ids">
     <div class="card-ids-header">
   <h3 class="card-ids-title">
        <i class="fa-solid fa-table-list text-info"></i>
      @Model.SelectedTable
           <span class="badge bg-primary ms-2">@Model.TotalRows rows</span>
  </h3>
     <div class="d-flex gap-2">
                @if (Model.CanWriteSelectedTable)
                {
                <button type="button" class="btn-ids btn-ids-success btn-ids-sm" data-bs-toggle="modal" data-bs-target="#addRowModal">
  <i class="fa-solid fa-plus"></i> Add Row
 </button>
                }
        <button type="button" class="btn-ids btn-ids-secondary btn-ids-sm" onclick="location.reload()">
    <i class="fa-solid fa-refresh"></i> Refresh
        </button>
      </div>
         </div>
          <div class="card-ids-body p-0">
     @if (Model.TableData.Any())
    {
    <div style="overflow-x: auto;">
    <table class="table-ids">
        <thead>
        <tr>
       @foreach (var col in Model.Columns)
      {
  <th>@col</th>
              }
 @if (Model.CanWriteSelectedTable)
 {
     <th style="width: 120px;">Actions</th>
 }
  </tr>
      </thead>
     <tbody>
        @foreach (var row in Model.TableData)
       {
       <tr>
  @foreach (var col in Model.Columns)
        {
      var value = row.ContainsKey(col) ? row[col]?.ToString() ?? "" : "";
  <td>
          @if (value.Length > 100)
  {
         <span title="@value">@value.Substring(0, 100)...</span>
        }
            else
       {
      @value
    }
       </td>
     }
        @if (Model.CanWriteSelectedTable)
        {
        <td>
     <div class="d-flex gap-1">
     <form method="post" asp-page-handler="DeleteRow" style="display:inline;" 
      onsubmit="return confirm('Are you sure you want to delete this row?');">
      <input type="hidden" name="tableName" value="@Model.SelectedTable" />
     <input type="hidden" name="rowId" value="@row.GetValueOrDefault("Id", row.Values.FirstOrDefault())" />
          <button type="submit" class="btn-ids btn-ids-danger btn-icon btn-icon-sm" title="Delete">
<i class="fa-solid fa-trash"></i>
        </button>
  </form>
        </div>
   </td>
        }
     </tr>
           }
        </tbody>
   </table>
 </div>
             
      <!-- Pagination -->
       @if (Model.TotalPages > 1)
       {
  <div class="card-ids-footer d-flex justify-content-between align-items-center">
  <span class="text-muted">Page @Model.CurrentPage of @Model.TotalPages</span>
         <nav>
     <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
<a class="page-link" href="?table=@Model.SelectedTable&page=@(Model.CurrentPage - 1)">Previous</a>
        </li>
     @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
     {
  <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
    <a class="page-link" href="?table=@Model.SelectedTable&page=@i">@i</a>
    </li>
  }
   <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
   <a class="page-link" href="?table=@Model.SelectedTable&page=@(Model.CurrentPage + 1)">Next</a>
         </li>
</ul>
      </nav>
  </div>
       }
         }
  else
  {
   <div class="empty-state">
         <i class="empty-state-icon fa-solid fa-inbox"></i>
             <h4 class="empty-state-title">No Data</h4>
           <p class="empty-state-text">This table is empty.</p>
   @if (Model.CanWriteSelectedTable) {
   <button type="button" class="btn-ids btn-ids-primary" data-bs-toggle="modal" data-bs-target="#addRowModal">
    <i class="fa-solid fa-plus"></i> Add First Row
   </button>
   }
       </div>
         }
        </div>
            </div>
        }
        else
      {
 <div class="card-ids">
   <div class="card-ids-body">
       <div class="empty-state">
    <i class="empty-state-icon fa-solid fa-hand-pointer"></i>
       <h4 class="empty-state-title">Select a Table</h4>
     <p class="empty-state-text">Choose a table from the sidebar to view its contents.</p>
   </div>
 </div>
     </div>
        }
    </div>
</div>

<!-- Add Row Modal -->
<div class="modal fade" id="addRowModal" tabindex="-1" aria-labelledby="addRowModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
         <form method="post" asp-page-handler="AddRow">
     <div class="modal-header">
   <h5 class="modal-title" id="addRowModalLabel">
  <i class="fa-solid fa-plus text-success me-2"></i>
     Add New Row to @Model.SelectedTable
     </h5>
           <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
  <div class="modal-body">
       <input type="hidden" name="tableName" value="@Model.SelectedTable" />
      @if (Model.Columns.Any())
     {
               @foreach (var col in Model.Columns.Where(c => c != "Id"))
         {
   <div class="form-group">
       <label class="form-label-ids">@col</label>
     <input type="text" name="values[@col]" class="form-control-ids" />
        </div>
       }
    }
   </div>
            <div class="modal-footer">
    <button type="button" class="btn-ids btn-ids-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn-ids btn-ids-success">
           <i class="fa-solid fa-plus me-1"></i> Add Row
       </button>
  </div>
      </form>
      </div>
    </div>
</div>

@functions {
    string GetTableIcon(string tableName)
    {
   return tableName.ToLower() switch
        {
         "aspnetusers" => "fa-users",
      "aspnetroles" => "fa-user-tag",
      "aspnetuserroles" => "fa-user-shield",
       "logfiles" => "fa-scroll",
       "securityalerts" => "fa-bell",
        "networkevents" => "fa-network-wired",
        "systemsettings" => "fa-gear",
   "auditlogs" => "fa-clipboard-list",
           "dashboardmetrics" => "fa-chart-line",
 _ => "fa-table"
    };
 }
}
