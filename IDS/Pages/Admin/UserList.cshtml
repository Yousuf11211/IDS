@page
@model IDS.Pages.Admin.UserListModel
@{
 ViewData["Title"] = "Manage users";
}

@section HeadContent{
 <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
 <div class="alert alert-info">@Model.StatusMessage</div>
}

<section class="user-filters mb-3">
 <form method="get" class="row g-2 align-items-end">
 <div class="col-auto">
 <label for="roleFilter" class="form-label mb-0">Filter by role</label>
 <select id="roleFilter" name="role" class="form-select">
 <option value="">All</option>
 @foreach (var r in Model.AllRoles)
 {
 <option value="@r" selected="@(Request.Query["role"] == r ? "selected" : null)">@r</option>
 }
 </select>
 </div>
 <div class="col-auto">
 <button class="btn btn-secondary" type="submit">Apply</button>
 </div>
 </form>
</section>

<table class="table table-striped user-table">
 <thead>
 <tr>
 <th>User</th>
 <th>Role</th>
 <th style="width:340px;">Change role</th>
 <th style="width:140px;">Actions</th>
 </tr>
 </thead>
 <tbody>
 @foreach (var u in Model.Users)
 {
 var roleClass = u.CurrentRole?.ToLowerInvariant() switch
 {
 "admin" => "role-badge role-admin",
 "employee" => "role-badge role-employee",
 "suspended" => "role-badge role-suspended",
 _ => "role-badge role-unknown"
 };
 <tr>
 <td>@u.Email</td>
 <td><span class="@roleClass">@(!string.IsNullOrEmpty(u.CurrentRole) ? u.CurrentRole : "None")</span></td>
 <td>
 <form method="post" asp-page-handler="SetRole" class="d-flex gap-2">
 <input type="hidden" name="userId" value="@u.Id" />
 <select name="role" class="form-select" style="max-width:220px;">
 @foreach (var r in Model.AllRoles)
 {
 <option value="@r" selected="@(string.Equals(r, u.CurrentRole, System.StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@r</option>
 }
 </select>
 <button class="btn btn-primary" type="submit">Update</button>
 </form>
 </td>
 <td>
 <form method="post" asp-page-handler="DeleteUser" onsubmit="return confirm('Delete this user? This cannot be undone.');">
 <input type="hidden" name="userId" value="@u.Id" />
 <button class="btn btn-sm btn-danger" type="submit">Delete</button>
 </form>
 </td>
 </tr>
 }
 </tbody>
</table>