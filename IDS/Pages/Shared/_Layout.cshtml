@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IDS Security</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo16qeRvEALZy9FTgvLqjAZaFJ0cJTgLJhLdJvMA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-users.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/IDS.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("HeadContent", required: false)
</head>
<body>
 <header>
  <nav class="navbar navbar-ids navbar-expand-lg">
    <div class="container-fluid px-4">
         <a class="navbar-brand" asp-area="" asp-page="/Index">
<i class="fa-solid fa-shield-halved"></i>
      IDS Security
            </a>
   
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
 </button>
                
<div class="navbar-collapse collapse" id="navbarMain">
       <ul class="navbar-nav me-auto">
@if (User?.Identity?.IsAuthenticated == true)
       {
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Dashboard" ? "active" : "")" asp-area="" asp-page="/Dashboard">
    <i class="fa-solid fa-gauge me-1"></i> Dashboard
  </a>
          </li>
  
<!-- Live Dashboard Link -->
<li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/LiveDashboard" ? "active" : "")" asp-area="" asp-page="/LiveDashboard">
  <i class="fa-solid fa-satellite-dish me-1"></i> Live Feed
    </a>
</li>

@if (Configuration.GetValue<bool>("Chat:Enabled"))
{
    <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Chat" ? "active" : "")"
           asp-area="" asp-page="/Chat">
            <i class="fa-solid fa-comments me-1"></i> Messages
        </a>
    </li>
}

   @if (User.IsInRole("Admin"))
       {
          <li class="nav-item">
          <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Alerts") == true ? "active" : "")" asp-area="" asp-page="/Admin/Alerts">
          <i class="fa-solid fa-bell me-1"></i> Alerts
      </a>
       </li>
       <li class="nav-item">
 <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/UserList") == true ? "active" : "")" asp-area="" asp-page="/Admin/UserList">
    <i class="fa-solid fa-users me-1"></i> Users
         </a>
   </li>
    <li class="nav-item">
    <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Database") == true ? "active" : "")" asp-area="" asp-page="/Admin/DatabaseViewer">
          <i class="fa-solid fa-database me-1"></i> Database
      </a>
 </li>
    <li class="nav-item">
          <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Admin/Logs") == true ? "active" : "")" asp-area="" asp-page="/Admin/Logs">
 <i class="fa-solid fa-scroll me-1"></i> Logs
    </a>
 </li>
      }
    
        @* Support Tickets - visible to Admin and Support roles *@
              @if (User.IsInRole("Admin") || User.IsInRole("Support"))
     {
           <li class="nav-item">
 <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Support/") == true ? "active" : "")" asp-area="" asp-page="/Support/Tickets">
          <i class="fa-solid fa-headset me-1"></i> Support Tickets
        </a>
             </li>
       }
    
        @* Submit Ticket - visible to all authenticated users *@
     <li class="nav-item">
      <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/SubmitTicket" || ViewContext.RouteData.Values["page"]?.ToString() == "/ViewTicket" ? "active" : "")" asp-area="" asp-page="/SubmitTicket">
  <i class="fa-solid fa-ticket me-1"></i> My Tickets
      </a>
   </li>
    }
else
        {
             <li class="nav-item">
   <a class="nav-link" asp-area="" asp-page="/Index">
     <i class="fa-solid fa-home me-1"></i> Home
  </a>
         </li>
            }
       
         <li class="nav-item">
     <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Help" ? "active" : "")" asp-area="" asp-page="/Help">
        <i class="fa-solid fa-circle-question me-1"></i> Help
         </a>
  </li>
 </ul>
   
    <div class="d-flex align-items-center gap-3">
    <!-- Theme Toggle -->
  <button id="themeToggle" class="btn btn-icon btn-ids-ghost" aria-label="Toggle theme" title="Toggle dark/light mode">
  <i class="fa-solid fa-moon" id="themeIcon"></i>
       </button>
          
 <partial name="_LoginPartial" />
   </div>
  </div>
            </div>
</nav>
  </header>

    @if (ViewData["FullWidthLayout"] != null)
 {
      <main role="main" class="main-content-full">
       @RenderBody()
</main>
    }
    else if (ViewData["NoContainer"] != null)
    {
    <main role="main">
  @RenderBody()
    </main>
    }
    else
    {
        <main role="main" class="main-content">
  <div class="container-fluid" style="max-width: 1400px;">
        @RenderBody()
            </div>
        </main>
    }

    <footer class="footer-ids">
  <div class="container">
       <span>&copy; @DateTime.Now.Year IDS Security System</span>
 <span class="mx-2">|</span>
        <a href="/Privacy" class="text-muted text-decoration-none">Privacy Policy</a>
  </div>
</footer>

 <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User?.Identity?.IsAuthenticated == true && Configuration.GetValue<bool>("Chat:Enabled"))
    {
        <script src="~/js/chat-notifications.js" asp-append-version="true" defer></script>
    }
    
    <script>
        // Site-wide theme state lives in site.js; this button only invokes it.
        document.getElementById('themeToggle')?.addEventListener('click', () => {
            window.IDS.ThemeManager.toggle();
        });
    </script>

 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
