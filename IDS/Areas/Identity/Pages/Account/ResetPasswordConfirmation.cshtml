@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password ready";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-6">
        <div class="card-ids">
            <div class="card-ids-body text-center p-5">
                <i class="fa-solid fa-circle-check text-success fa-3x mb-3" aria-hidden="true"></i>
                <h1 class="h3">Your password is ready</h1>
                <p class="text-muted">Sign in with your new password. If this is your first login, you will be guided through authenticator setup.</p>
                <a asp-page="./Login" class="btn-ids btn-ids-primary">Continue to sign in</a>
            </div>
        </div>
    </div>
</div>
