@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}
<section class="card-ids card-ids-body">
    <h1 class="h4">Set up authenticator</h1>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (Model.SharedKey == null)
    {
        <p>Verify your current password to reveal the enrollment QR code.</p>
        <form method="post" asp-page-handler="Prepare">
            <label asp-for="Password" class="form-label">Current password</label>
            <input asp-for="Password" class="form-control mb-3" autocomplete="current-password" required>
            <button type="submit" class="btn-ids btn-ids-primary">Continue enrollment</button>
        </form>
    }
    else
    {
        <p>Scan this QR code in your authenticator app or add it with the manual key.</p>
        <img class="mw-100 rounded d-block mb-3" src="@Model.QrImage" alt="Authenticator enrollment QR code">
        <p>Manual key <code class="text-break">@Model.SharedKey</code></p>
        <form method="post" data-confirm="Enable your authenticator with this enrollment?">
            <label asp-for="Password" class="form-label">Current password</label>
            <input asp-for="Password" class="form-control mb-3" autocomplete="current-password" required>
            <label asp-for="Code" class="form-label">Six-digit authenticator code</label>
            <input asp-for="Code" class="form-control mb-3" inputmode="numeric" maxlength="7" autocomplete="one-time-code" required>
            <button type="submit" class="btn-ids btn-ids-primary">Confirm and enable authenticator</button>
        </form>
    }
</section>
