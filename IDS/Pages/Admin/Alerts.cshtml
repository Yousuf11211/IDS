@page
@model IDS.Pages.Admin.AlertsModel
@{
    ViewData["Title"] = "Security alerts";
}
<div class="monitoring-page">
    <header class="monitoring-heading">
        <h1>Security alerts</h1>
        <a asp-page="/Admin/Operations" asp-fragment="alert-settings" class="btn-ids btn-ids-secondary btn-ids-sm">Alert rules</a>
    </header>
    <p class="text-muted mb-0">Review actionable events from grouped malicious detections, worker health, and configured account security events.</p>
    @if (Model.Result != null) { <div class="alert alert-info" role="status">@Model.Result</div> }
    <form method="get" class="monitoring-filters">
        <label>Period
            <select class="form-select form-select-sm" asp-for="DateRange"><option value="today">Today (UTC)</option><option value="week">Last 7 days</option><option value="month">Last 30 days</option><option value="all">All time</option></select>
        </label>
        <label>Severity
            <select class="form-select form-select-sm" asp-for="Severity"><option value="">All severities</option>
                @foreach (var severity in IDS.Core.Services.SecurityAlertSettings.Severities.Append("Info")) { <option>@severity</option> }
            </select>
        </label>
        <label>Status
            <select class="form-select form-select-sm" asp-for="Status"><option value="">All statuses</option><option value="active">Active</option><option value="unacknowledged">Unacknowledged</option><option value="acknowledged">Acknowledged</option><option value="resolved">Resolved</option></select>
        </label>
        <label>Category
            <select class="form-select form-select-sm" asp-for="Category"><option value="">All categories</option>
                @foreach (var category in IDS.Core.Services.SecurityAlertSettings.Categories) { <option>@category</option> }
            </select>
        </label>
        <button type="submit" class="btn-ids btn-ids-secondary btn-ids-sm">Apply filters</button>
    </form>
    <div class="monitoring-grid">
        @foreach (var metric in Model.Metrics)
        {
            <div class="monitor-metric"><i class="fa-solid fa-bell" aria-hidden="true"></i><span>@metric.Label</span><strong>@metric.Count.ToString("N0")</strong></div>
        }
    </div>
    @if (Model.SeverityCounts.Count > 0)
    {
        <div class="monitoring-panels">
            <section class="card-ids card-ids-body">
                <h2 class="h6">Severity distribution</h2>
                <dl class="monitoring-list">
                    @foreach (var item in Model.SeverityCounts)
                    {
                        <div><dt>@item.Label</dt>
                            <dd class="alert-distribution" data-severity="@item.Label">
                                <progress aria-hidden="true" max="@Model.SeverityCounts.Sum(row => row.Count)" value="@item.Count"></progress>
                                <span>@item.Count.ToString("N0")</span>
                            </dd>
                        </div>
                    }
                </dl>
            </section>
            @if (Model.DailyCounts.Count > 0)
            {
                <section class="card-ids card-ids-body">
                    <h2 class="h6">Recent alerts by first observed date (UTC)</h2>
                    <dl class="monitoring-list monitoring-scroll">
                        @foreach (var item in Model.DailyCounts)
                        {
                            <div><dt>@item.Label</dt>
                                <dd class="alert-distribution">
                                    <progress aria-hidden="true" max="@Model.DailyCounts.Max(row => row.Count)" value="@item.Count"></progress>
                                    <span>@item.Count.ToString("N0")</span>
                                </dd>
                            </div>
                        }
                    </dl>
                </section>
            }
        </div>
    }
    <div class="card-ids table-responsive">
        <table class="table-ids mb-0">
            <thead><tr><th>Alert</th><th>Category</th><th>Severity</th><th>Detections</th><th>First observed (UTC)</th><th>Last observed (UTC)</th><th>Status</th><th>Incident</th><th>Assigned</th><th>Actions</th></tr></thead>
            <tbody>
            @foreach (var alert in Model.Alerts)
            {
                <tr>
                    <td><a asp-page="/Admin/AlertDetails" asp-route-id="@alert.Id" data-attack-label="@alert.AttackLabel">@alert.AlertType</a></td>
                    <td>@(alert.EventCategory ?? "Recorded alert")</td>
                    <td><span class="severity-badge severity-@alert.Severity.ToLowerInvariant()">@alert.Severity</span></td>
                    <td>@(alert.EventCategory == "Detection" ? alert.DetectionCount.ToString("N0") : "—")</td>
                    <td>@alert.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@((alert.LastObservedAt ?? alert.Timestamp).ToString("yyyy-MM-dd HH:mm"))</td>
                    <td>@IDS.Pages.Admin.AlertsModel.State(alert)</td>
                    <td>@if (alert.Ticket != null) { <a asp-page="/Support/ManageTicket" asp-route-id="@alert.TicketId">@alert.Ticket.TicketNumber</a> } else { <span>—</span> }</td>
                    <td>@(alert.Ticket?.AssignedToName ?? "—")</td>
                    <td>
                        @if (!alert.IsAcknowledged && alert.ResolvedAt == null)
                        {
                            <form method="post" asp-page-handler="Acknowledge" asp-route-severity="@Model.Severity" asp-route-status="@Model.Status" asp-route-dateRange="@Model.DateRange" asp-route-category="@Model.Category" asp-route-p="@Model.P">
                                <input type="hidden" name="alertId" value="@alert.Id" />
                                <button type="submit" class="btn-ids btn-ids-secondary btn-ids-sm">Acknowledge</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Alerts.Count == 0)
            {
                <tr><td colspan="10" class="p-4 text-muted">No security alerts match this period and filters.</td></tr>
            }
            </tbody>
        </table>
    </div>
    <nav class="d-flex align-items-center gap-2" aria-label="Alert pages">
        @if (Model.P > 1) { <a asp-route-p="@(Model.P - 1)" asp-route-severity="@Model.Severity" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-dateRange="@Model.DateRange">Previous</a> }
        <span>Page @Model.P</span>
        @if (Model.HasNext) { <a asp-route-p="@(Model.P + 1)" asp-route-severity="@Model.Severity" asp-route-status="@Model.Status" asp-route-category="@Model.Category" asp-route-dateRange="@Model.DateRange">Next</a> }
    </nav>
    @if (!Model.BackfillScheduled)
    {
        <details class="card-ids card-ids-body">
            <summary>Process historical detections</summary>
            <p class="small text-muted mt-2">Queue a one-time backfill of up to 30 days of detections from before the alert monitor started.</p>
            <form method="post" asp-page-handler="Backfill" class="monitoring-filters">
                <label>Days <input class="form-control form-control-sm" type="number" name="days" min="1" max="30" value="7" required /></label>
                <button class="btn-ids btn-ids-secondary btn-ids-sm" type="submit">Schedule backfill</button>
            </form>
        </details>
    }
</div>
