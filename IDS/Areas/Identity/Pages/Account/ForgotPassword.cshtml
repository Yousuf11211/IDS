@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset your password";
}
<section class="card-ids card-ids-body mx-auto" style="max-width: 36rem">
    <h1 class="h3">Reset your password</h1>
    <p class="text-muted">Enter your registered email to request a secure reset link.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label asp-for="Input.Email" class="form-label">Registered email</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
        <button type="submit" class="btn-ids btn-ids-primary mt-3">Request reset link</button>
    </form>
    <div class="d-flex flex-wrap gap-3 mt-3">
        <a asp-page="./Login">Back to sign in</a>
        <a asp-page="./AuthenticatorRecovery">Request authenticator reset</a>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
