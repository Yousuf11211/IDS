@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable authenticator";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}
<section class="card-ids card-ids-body">
    <h1 class="h4">Disable authenticator</h1>
    @if (Model.CanDisable)
    {
        <p>Disabling the authenticator removes your enrollment and recovery codes and signs you out.</p>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <form method="post" data-confirm="Remove your authenticator and recovery codes?">
            <label asp-for="Password" class="form-label">Current password</label>
            <input asp-for="Password" class="form-control mb-3" autocomplete="current-password" required>
            <label asp-for="Code" class="form-label">Authenticator or recovery code</label>
            <input asp-for="Code" type="password" class="form-control mb-3" maxlength="64" autocomplete="one-time-code" required>
            <div class="form-check mb-3">
                <input asp-for="UseRecoveryCode" class="form-check-input">
                <label asp-for="UseRecoveryCode" class="form-check-label">Use a recovery code</label>
            </div>
            <button type="submit" class="btn-ids btn-ids-danger">Confirm and disable authenticator</button>
        </form>
    }
    else
    {
        <p>Your organization requires an authenticator for this account.</p>
    }
    <a class="mt-3 d-inline-block" asp-page="./TwoFactorAuthentication">Back to authenticator settings</a>
</section>
