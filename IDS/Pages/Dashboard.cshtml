@page
@model IDS.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["FullWidthLayout"] = true; @* <-- Signals _Layout.cshtml to remove padding/container *@
}

@section HeadContent {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
}

<div class="dashboard-container">
    @* ===============================================
       CUSTOM SIDEBAR
       =============================================== *@
    <aside class="sidebar">
        <div class="logo-area">
            <h2>IDS Monitor</h2>
        </div>
        <nav class="main-nav">
            <ul>
                @* NOTE: You need to add Razor Page links (asp-page) to these if you build them *@
                <li class="active"><a asp-page="/Dashboard"><i class="fas fa-chart-line"></i> Dashboard</a></li>
                @* Conditional links for Admin vs. Employee *@
                @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                {
                    <li><a asp-page="/Admin/UserList"><i class="fas fa-user-cog"></i> Admin Users</a></li>
                }
                <li><a href="#"><i class="fas fa-exclamation-triangle"></i> Alerts Log</a></li>
                <li><a href="#"><i class="fas fa-shield-alt"></i> Configuration</a></li>
                <li><a href="#"><i class="fas fa-user-cog"></i> Profile</a></li>
            </ul>
        </nav>
        @* The duplicate logout section has been removed here *@
    </aside>

    @* ===============================================
       MAIN CONTENT
       =============================================== *@
    <main class="main-content">
        <header class="dashboard-header">
            <h1>Overview</h1>
            <div class="user-info">
                @* Dynamic User Name *@
                <span id="welcome-user">Welcome, @User.Identity.Name!</span>
                <i class="fas fa-bell"></i>
            </div>
        </header>

        @* Analysis Control (Retained for future IDS logic) *@
        <section class="analysis-control">
            <h2>Real-Time Analysis Input</h2>
            <div class="input-group">
                <label for="csv-file-input">Select Trafic Log (CSV)</label>
                <input type="file" id="csv-file-input" accept=".csv">
                <button id="start-analysis-btn" disabled>Start Analysis</button>
            </div>
            <p id="analysis-status-message"></p>
        </section>

        @* METRICS GRID: Visible only to Admin users based on prior request *@
        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
        {
            <section class="metrics-grid">
                <div class="metric-card primary">
                    <i class="fas fa-bug icon"></i>
                    <p class="label">Total Logs Recorded</p>
                    @* Dynamic Total Logs *@
                    <p class="value" id="total-attacks">@Model.TotalLogs</p>
                </div>
                <div class="metric-card danger">
                    <i class="fas fa-fire icon"></i>
                    <p class="label">Critical Logs</p>
                    @* Dynamic Highest Severity (Use LevelCounts for a rough count for now) *@
                    <p class="value" id="highest-severity">@(Model.LevelCounts.TryGetValue("Error", out int criticalCount) ? criticalCount.ToString() : (Model.LevelCounts.TryGetValue("Warning", out int warningCount) ? warningCount.ToString() : "0"))</p>
                </div>
                <div class="metric-card info">
                    <i class="fas fa-network-wired icon"></i>
                    <p class="label">Information Logs</p>
                    @* Dynamic Total Traffic (Proxy with Info Count) *@
                    <p class="value" id="traffic-volume">@(Model.LevelCounts.TryGetValue("Information", out int infoCount) ? infoCount.ToString() : "0")</p>
                </div>
                <div class="metric-card success">
                    <i class="fas fa-check-circle icon"></i>
                    <p class="label">IDS Status</p>
                    <p class="value" id="system-status">Operational</p>
                </div>
            </section>
        }
        else
        {
            <p class="text-muted">Welcome to the IDS Dashboard. System metrics are available to Administrators.</p>
        }


        @* VISUALIZATION AND LOGS: Use existing AJAX logic *@
        @* The chart area requires more dynamic data than currently available, but the structure is set up. *@
        <section class="visualization-area">
            <div class="chart-panel chart-full">
                <h2>Attack Types Breakdown</h2>
                <div class="chart-container" style="position: relative; height:40vh; width:100%">
                    <canvas id="attackTypeChart"></canvas>
                </div>
            </div>
            <div class="chart-panel recent-alerts">
                <h2>Recent System Logs</h2>
                @* Log table reuses the existing logic via the Logs Management click event *@
                <table id="alerts-table">
                    <thead>
                        <tr>
                            <th>Time (UTC)</th>
                            <th>Level</th>
                            <th>Message</th>
                            <th>User ID</th>
                        </tr>
                    </thead>
                    <tbody id="alerts-table-body">
                        @* This is the default display. Content is populated by JavaScript after clicking the log link. *@
                        <tr><td colspan="4" class="no-data">Click the Alerts Log link to load recent system entries...</td></tr>
                    </tbody>
                </table>
            </div>
        </section>

        @* The dashboard-content div is no longer needed but we keep the ID for the JS *@
        <div id="dashboard-content" style="display:none;"></div>

    </main>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        (function() {
            const logsLink = document.querySelector('a[href="#"][class*="fa-exclamation-triangle"]');
            if (logsLink) logsLink.addEventListener('click', async function(e) {
                e.preventDefault();
                const tableBody = document.getElementById('alerts-table-body');
                tableBody.innerHTML = '<tr><td colspan="4" class="no-data">Loading logs...</td></tr>';

                const res = await fetch('?handler=GetLogs');
                if (!res.ok) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="no-data text-danger">Failed to load logs</td></tr>';
                    return;
                }
                const logs = await res.json();
                if (!logs || logs.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="no-data">No logs found.</td></tr>';
                    return;
                }

                let html = '';
                for (const l of logs) {
                    let levelClass = '';
                    if (l.level === 'Error') levelClass = 'severity-critical';
                    else if (l.level === 'Warning') levelClass = 'severity-medium';

                    html += `<tr>
                                <td>${new Date(l.timestamp).toISOString().replace('T',' ').substr(0,19)}</td>
                                <td class="${levelClass}">${l.level}</td>
                                <td>${l.message}</td>
                                <td>${l.userId || ''}</td>
                            </tr>`;
                }
                tableBody.innerHTML = html;
            });

            const ctx = document.getElementById('attackTypeChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Brute Force', 'SQL Injection', 'DDoS', 'XSS'],
                        datasets: [{
                            label: 'Attacks',
                            data: [12, 3, 5, 2], // Static demo data - REPLACE WITH C# DATA
                            backgroundColor: [
                                '#e74c3c',
                                '#f39c12',
                                '#3498db',
                                '#2ecc71'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }

        })();
    </script>
}