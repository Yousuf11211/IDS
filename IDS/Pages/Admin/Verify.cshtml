@page
@model IDS.Pages.Admin.VerifyModel
@{ ViewData["Title"] = "Verify administrator access"; }
<div class="row justify-content-center py-4">
    <div class="col-lg-6">
        <div class="card-ids">
            <div class="card-ids-body p-4">
                <h1 class="h3"><i class="fa-solid fa-user-shield me-2" aria-hidden="true"></i>Verify administrator access</h1>
                <p class="text-muted">@(Model.TestingBypass ? "Confirm your password. Administrator authenticator codes are bypassed for development testing." : "Confirm your password and current authenticator code.") Verification lasts five minutes in this browser session. If a form expired, review and submit it again afterward.</p>
                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label-ids">Current password</label>
                        <input asp-for="Input.Password" class="form-control-ids" autocomplete="current-password" />
                    </div>
                    @if (!Model.TestingBypass)
                    {
                    <div class="form-group">
                        <label asp-for="Input.Code" class="form-label-ids">Authenticator code</label>
                        <input asp-for="Input.Code" class="form-control-ids" autocomplete="one-time-code" inputmode="numeric" required />
                    </div>
                    }
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-page="/Dashboard" class="btn-ids btn-ids-secondary">Back to dashboard</a>
                        <button class="btn-ids btn-ids-primary" type="submit">Verify access</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
