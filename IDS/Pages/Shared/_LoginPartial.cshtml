@using Microsoft.AspNetCore.Identity
@using IDS.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = userRoles.FirstOrDefault() ?? "User";
    var initials = currentUser?.FirstName?.FirstOrDefault().ToString()?.ToUpper() ?? currentUser?.Email?.FirstOrDefault().ToString()?.ToUpper() ?? "U";
    var displayName = !string.IsNullOrEmpty(currentUser?.FirstName) ? currentUser.FirstName : currentUser?.Email?.Split('@')[0];
    
    <div class="user-dropdown">
        <button id="userMenuToggle" class="user-trigger" type="button" aria-haspopup="true" aria-expanded="false">
      <div class="user-avatar">@initials</div>
   <div class="user-info d-none d-md-block">
    <div class="user-name">@displayName</div>
           <div class="user-role">@primaryRole</div>
         </div>
            <i class="fa-solid fa-chevron-down ms-2" style="font-size: 0.75rem; opacity: 0.7;"></i>
        </button>
        
<div id="userMenu" class="dropdown-panel">
      <div class="dropdown-header">
      <div class="user-name">@(currentUser?.FirstName != null ? $"{currentUser.FirstName} {currentUser.LastName}" : currentUser?.Email)</div>
             <div class="text-muted" style="font-size: 0.8125rem;">@currentUser?.Email</div>
  </div>
   
      <nav class="dropdown-links">
         <a asp-area="Identity" asp-page="/Account/Manage/Index" class="dropdown-link">
 <i class="fa-solid fa-user"></i> Profile
          </a>
       <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="dropdown-link">
             <i class="fa-solid fa-key"></i> Change Password
       </a>
      <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication" class="dropdown-link">
         <i class="fa-solid fa-shield-halved"></i> Two-Factor Auth
    </a>
   
      <div class="dropdown-divider"></div>
    
       <a asp-area="Identity" asp-page="/Account/Manage/PersonalData" class="dropdown-link">
      <i class="fa-solid fa-download"></i> Personal Data
         </a>
          <a asp-page="/Help" class="dropdown-link">
          <i class="fa-solid fa-circle-question"></i> Help & Support
     </a>
   </nav>
            
            <div class="dropdown-footer">
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
        <button type="submit" class="btn-logout">
   <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
       </button>
     </form>
        </div>
        </div>
    </div>
    
    <script>
        (function(){
   const trigger = document.getElementById('userMenuToggle');
     const panel = document.getElementById('userMenu');
   let isOpen = false;
   
            function open() {
        panel.classList.add('open');
      trigger.setAttribute('aria-expanded', 'true');
     isOpen = true;
}
       
         function close() {
         panel.classList.remove('open');
      trigger.setAttribute('aria-expanded', 'false');
      isOpen = false;
 }
      
      trigger.addEventListener('click', (e) => {
                e.stopPropagation();
              isOpen ? close() : open();
            });

            document.addEventListener('click', (e) => {
        if (!panel.contains(e.target) && !trigger.contains(e.target)) {
    close();
    }
     });
       
      document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') close();
       });
            
    // Inactivity logout (configurable timeout)
        const INACTIVITY_TIMEOUT = 1800000; // 30 minutes
        let inactivityTimer;
       
 function resetInactivityTimer() {
     clearTimeout(inactivityTimer);
        inactivityTimer = setTimeout(() => {
            window.location.href = '/Identity/Account/Logout?handler=Inactivity';
                }, INACTIVITY_TIMEOUT);
   }
        
       ['click', 'mousemove', 'keydown', 'scroll', 'touchstart'].forEach(evt => {
         document.addEventListener(evt, resetInactivityTimer, { passive: true });
            });
      resetInactivityTimer();
        })();
    </script>
}
else
{
    <a href="/Identity/Account/Login" class="btn-ids btn-ids-primary">
  <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
  </a>
}
