@page
@model Disable2faModel
@{
    ViewData["Title"] = "Two-factor authentication required";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card-ids">
    <div class="card-ids-body">
        <h1 class="h4">Two-factor authentication is required</h1>
        <p class="text-muted">Company accounts must keep an authenticator enabled.</p>
        <a asp-page="./TwoFactorAuthentication" class="btn-ids btn-ids-primary d-inline-flex align-items-center justify-content-center">
            Back to security settings
        </a>
    </div>
</div>
