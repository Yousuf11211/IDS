<section class="card-ids appearance-settings">
    <div class="card-ids-header">
        <h2 class="card-ids-title"><i class="fa-solid fa-palette text-primary" aria-hidden="true"></i> Appearance</h2>
    </div>
    <div class="card-ids-body">
        <fieldset>
            <legend class="h6">Choose your theme</legend>
            <p class="text-secondary small">Apply a consistent look across IDS. Changes save automatically in this browser.</p>
            <div class="theme-options">
                <label class="theme-option">
                    <input type="radio" name="appearance" value="light" data-theme-choice />
                    <i class="fa-solid fa-sun" aria-hidden="true"></i>
                    <span>Light</span>
                </label>
                <label class="theme-option">
                    <input type="radio" name="appearance" value="dark" data-theme-choice />
                    <i class="fa-solid fa-moon" aria-hidden="true"></i>
                    <span>Dark</span>
                </label>
                <label class="theme-option">
                    <input type="radio" name="appearance" value="system" data-theme-choice />
                    <i class="fa-solid fa-desktop" aria-hidden="true"></i>
                    <span>System</span>
                </label>
            </div>
        </fieldset>
        <p class="text-secondary small mt-3 mb-0" role="status" data-theme-status>System follows your device's appearance.</p>
    </div>
</section>
