@page
@model IDS.Pages.LiveDashboardModel
@{
    ViewData["Title"] = "Detection live feed";
    var canInspect = User.IsInRole("Admin") || User.IsInRole("Support");
}

<div class="monitoring-page">
    <header class="monitoring-heading">
        <h1>Detection live feed</h1>
        <a asp-page="/DetectionHistory" class="btn-ids btn-ids-secondary btn-ids-sm">Detection history</a>
    </header>
    <section class="card-ids card-ids-body monitoring-health" aria-label="Worker health">
        <partial name="_WorkerHealth" />
    </section>
    <partial name="_TrafficAnalytics" model='"live"' />
    <div class="monitoring-page" data-feed data-url="@Url.Content("~/api/monitoring/feed")"
         data-hub="@Url.Content("~/hubs/dashboard")" data-inspect="@(canInspect ? Url.Page("/InspectAttack", new { id = 1 }) : null)"
         data-history="@Url.Page("/DetectionHistory")" data-escalate="@Url.Page("/EscalateAttack", new { id = 1 })"
         data-ticket="@Url.Page("/ViewTicket", new { id = 1 })">
        <section class="card-ids" data-recent-section>
            <header class="card-ids-header"><h2 class="h5 mb-0">Recent malicious activity</h2></header>
            <div class="table-responsive monitoring-scroll" tabindex="0" aria-label="Recent malicious flows">
                <table class="table-ids mb-0">
                    <thead><tr><th>Detected (UTC)</th><th>Model class</th><th>Source</th><th>Destination port</th>
                        <th>Confidence</th><th>Severity</th><th>SHAP job</th><th>Investigation</th></tr></thead>
                    <tbody data-feed-recent><tr><td colspan="8">Loading recent activity…</td></tr></tbody>
                </table>
            </div>
        </section>
        <section class="card-ids">
            <header class="card-ids-header"><h2 class="h5 mb-0">Detection records</h2><span class="small text-muted" data-feed-status role="status"></span></header>
            <div class="card-ids-body">
                <form class="monitoring-filters" data-feed-form>
                    <label>Search source, port or class
                        <input type="search" name="search" maxlength="100" class="form-control form-control-sm" />
                    </label>
                    <label>Binary classification
                        <select class="form-select form-select-sm" name="traffic"><option value="">All traffic</option><option value="benign">Benign</option><option value="malicious">Malicious</option></select>
                    </label>
                    <label>Model class
                        <select class="form-select form-select-sm" name="category"><option value="">All classes</option></select>
                    </label>
                    <label>Explanation
                        <select class="form-select form-select-sm" name="explanation"><option value="">Any status</option><option>Available</option><option>Pending</option><option>Failed</option><option>No job</option><option value="not-applicable">Not applicable</option></select>
                    </label>
                    <label>Sort
                        <select class="form-select form-select-sm" name="sort"><option value="latest">Newest first</option><option value="oldest">Oldest first</option><option value="confidence">Highest confidence</option><option value="source">Source address</option></select>
                    </label>
                    <button type="submit" class="btn-ids btn-ids-secondary btn-ids-sm">Apply filters</button>
                    <button type="reset" class="btn-ids btn-ids-secondary btn-ids-sm">Clear filters</button>
                </form>
            </div>
            <div class="table-responsive" tabindex="0" aria-label="Detection records">
                <table class="table-ids mb-0">
                    <thead><tr><th>Detected (UTC)</th><th>Source</th><th>Destination port</th><th>Classification</th>
                        <th>Model class</th><th>Confidence</th><th>Severity</th><th>SHAP job</th><th>Incident</th><th>Investigation</th></tr></thead>
                    <tbody data-feed-rows><tr><td colspan="10">Loading detections…</td></tr></tbody>
                </table>
            </div>
            <div class="card-ids-footer d-flex gap-2 align-items-center flex-wrap">
                <button type="button" class="btn-ids btn-ids-secondary btn-ids-sm" data-page-step="-1" disabled>Previous</button>
                <span class="small" data-page-number>Page 1</span>
                <button type="button" class="btn-ids btn-ids-secondary btn-ids-sm" data-page-step="1" disabled>Next</button>
                <button type="button" class="btn-ids btn-ids-secondary btn-ids-sm ms-auto" data-hide-feed>Clear display</button>
                <button type="button" class="btn-ids btn-ids-secondary btn-ids-sm" data-refresh-feed>Refresh records</button>
            </div>
        </section>
        <div class="d-flex flex-wrap gap-3 small">
            <label><input type="checkbox" data-feed-sound /> Malicious detection sound</label>
            <label><input type="checkbox" data-feed-desktop /> Browser notifications</label>
            <span class="text-muted" data-feed-connection>Connecting to live events…</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" defer></script>
    <script src="~/js/live-feed.js" asp-append-version="true" defer></script>
}
