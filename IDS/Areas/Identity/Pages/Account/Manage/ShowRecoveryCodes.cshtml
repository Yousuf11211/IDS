@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Save recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <div class="page-header-hero">
        <h1 class="page-header-title"><i class="fa-solid fa-key" aria-hidden="true"></i> Save your recovery codes</h1>
        <p class="page-header-subtitle">Each code can be used once if you cannot access your authenticator.</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card-ids" style="max-width: 680px;">
    <div class="card-ids-body">
        <div class="alert-ids alert-ids-warning mb-4" role="alert">
            <i class="alert-ids-icon fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <div class="alert-ids-content">Store these codes in a secure password manager. They will not be shown again.</div>
        </div>

        <div class="row g-2 mb-4" aria-label="Recovery codes">
            @foreach (var code in Model.RecoveryCodes)
            {
                <div class="col-sm-6">
                    <code class="d-block p-3 rounded text-center" style="background: var(--bg-tertiary); color: var(--text-primary); font-size: 1rem;">@code</code>
                </div>
            }
        </div>

        <a asp-page="/Index" asp-area="" class="btn-ids btn-ids-primary d-inline-flex align-items-center justify-content-center">
            Continue to dashboard
        </a>
    </div>
</div>
