@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate recovery codes";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="page-header">
    <div class="page-header-hero">
        <h1 class="page-header-title"><i class="fa-solid fa-key" aria-hidden="true"></i> Generate recovery codes</h1>
        <p class="page-header-subtitle">Create new single-use codes for times when your authenticator is unavailable.</p>
    </div>
</div>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card-ids" style="max-width: 640px;">
    <div class="card-ids-body">
        <div class="alert-ids alert-ids-warning mb-4" role="alert">
            <i class="alert-ids-icon fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
            <div class="alert-ids-content">Generating new codes invalidates your current recovery codes. Save the new codes somewhere secure.</div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <div class="form-group">
                <label asp-for="Input.Password" class="form-label-ids"></label>
                <input asp-for="Input.Password" class="form-control-ids" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.Code" class="form-label-ids"></label>
                <input asp-for="Input.Code" class="form-control-ids" autocomplete="one-time-code" inputmode="numeric" />
                <span asp-validation-for="Input.Code" class="form-error"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-ids btn-ids-danger d-inline-flex align-items-center justify-content-center gap-2">
                    <i class="fa-solid fa-key" aria-hidden="true"></i>
                    <span>Generate new codes</span>
                </button>
                <a asp-page="./TwoFactorAuthentication" class="btn-ids btn-ids-secondary d-inline-flex align-items-center justify-content-center">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
