@page
@model IDS.Areas.Identity.Pages.Account.FirstTimeSetupModel
@{
    ViewData["Title"] = "Account Setup";
    ViewData["NoContainer"] = true;
}

<div class="login-page">
    <div class="login-container" style="max-width: 500px;">
        <div class="login-card">
            <div class="login-logo">
                <i class="fa-solid fa-user-gear"></i>
            </div>
            <h1 class="login-title">Complete Your Setup</h1>
            <p class="login-subtitle">Step 1 of 2: update your details and password. Next, connect an authenticator app.</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert-ids alert-ids-danger mb-4"
                    role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Input.FirstName" class="form-label-ids">First Name</label>
                            <input asp-for="Input.FirstName" class="form-control-ids" placeholder="John" />
                            <span asp-validation-for="Input.FirstName" class="form-error"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="Input.LastName" class="form-label-ids">Last Name</label>
                            <input asp-for="Input.LastName" class="form-control-ids" placeholder="Doe" />
                            <span asp-validation-for="Input.LastName" class="form-error"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Input.UserName" class="form-label-ids">Username *</label>
                    <div class="input-group">
                        <span class="input-group-text"
                            style="background: var(--bg-tertiary); border-color: var(--border-color);">
                            <i class="fa-solid fa-at text-muted"></i>
                        </span>
                        <input asp-for="Input.UserName" class="form-control-ids"
                            style="border-top-left-radius: 0; border-bottom-left-radius: 0;" />
                    </div>
                    <span asp-validation-for="Input.UserName" class="form-error"></span>
                </div>

                <hr class="my-4" />

                <div class="form-group">
                    <label asp-for="Input.NewPassword" class="form-label-ids">New Password *</label>
                    <div class="input-group">
                        <span class="input-group-text"
                            style="background: var(--bg-tertiary); border-color: var(--border-color);">
                            <i class="fa-solid fa-lock text-muted"></i>
                        </span>
                        <input asp-for="Input.NewPassword" type="password" class="form-control-ids"
                            style="border-top-left-radius: 0; border-bottom-left-radius: 0;"
                            placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.NewPassword" class="form-error"></span>
                    <p class="form-text">Must be at least 6 characters long.</p>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmNewPassword" class="form-label-ids">Confirm Password *</label>
                    <div class="input-group">
                        <span class="input-group-text"
                            style="background: var(--bg-tertiary); border-color: var(--border-color);">
                            <i class="fa-solid fa-lock text-muted"></i>
                        </span>
                        <input asp-for="Input.ConfirmNewPassword" type="password" class="form-control-ids"
                            style="border-top-left-radius: 0; border-bottom-left-radius: 0;"
                            placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Input.ConfirmNewPassword" class="form-error"></span>
                </div>

                <button type="submit"
                    class="btn-ids btn-ids-success btn-ids-lg w-100 mt-4 d-flex align-items-center justify-content-center">
                    <i class="fa-solid fa-arrow-right me-2"></i> Continue to Authenticator Setup
                </button>
            </form>
        </div>

        <div class="card-ids mt-4">
            <div class="card-ids-body">
                <div class="d-flex gap-3">
                    <div class="metric-icon gradient-blue"
                        style="width: 40px; height: 40px; font-size: 1rem;">
                        <i class="fa-solid fa-shield-check"></i>
                    </div>
                    <div>
                        <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Security Notice</h4>
                        <p class="text-muted mb-0" style="font-size: 0.875rem;">
                            For your security, complete both steps before accessing the system.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
