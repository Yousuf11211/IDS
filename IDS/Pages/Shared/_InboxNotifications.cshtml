<div class="nav-item dropdown" data-inbox-url="@Url.Page("/Inbox", "Recent", new { area = "" })">
    <button class="nav-link dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-inbox" aria-hidden="true"></i> Inbox
        <span class="badge text-bg-primary" data-inbox-count hidden></span>
    </button>
    <div class="dropdown-menu dropdown-menu-end inbox-dropdown">
        <form method="post" asp-area="" asp-page="/Inbox" asp-page-handler="Open" data-inbox-form>
            <div data-inbox-recent class="p-2">Loading notifications…</div>
        </form>
        <a class="dropdown-item border-top pt-2" asp-area="" asp-page="/Inbox">View all notifications</a>
    </div>
</div>
<script src="~/js/inbox.js" asp-append-version="true" defer></script>
