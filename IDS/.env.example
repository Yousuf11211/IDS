# IDS Environment Variables
# Copy this file to .env and fill in your values

# Admin User Credentials (used for seeding)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123!

# Mailjet Email Service
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_SECRET_KEY=your_mailjet_secret_key_here
MAILJET_SENDER_EMAIL=noreply@yourdomain.com
MAILJET_SENDER_NAME=IDS System

# Database Connection (optional - defaults to appsettings.json if not set)
# CONNECTION_STRING=Server=localhost;Database=IDS;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
