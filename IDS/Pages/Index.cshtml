@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    ViewData["NoContainer"] = true;
}

@section HeadContent {
    <style>
        .hero-section {
  min-height: calc(100vh - var(--header-height) - 80px);
            display: flex;
     align-items: center;
background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            position: relative;
            overflow: hidden;
        }
        
        .hero-section::before {
          content: '';
       position: absolute;
            top: 0;
          left: 0;
      right: 0;
        bottom: 0;
            background: 
                radial-gradient(circle at 20% 80%, rgba(59, 130, 246, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 20%, rgba(139, 92, 246, 0.15) 0%, transparent 50%);
        }
        
        .hero-content {
      position: relative;
         z-index: 1;
    padding: 4rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
        }
        
        .hero-badge {
            display: inline-flex;
            align-items: center;
   gap: 0.5rem;
 padding: 0.5rem 1rem;
        background: rgba(59, 130, 246, 0.1);
   border: 1px solid rgba(59, 130, 246, 0.2);
        border-radius: var(--radius-full);
            color: var(--primary-light);
            font-size: 0.875rem;
            font-weight: 500;
     margin-bottom: 1.5rem;
        }
        
        .hero-title {
       font-size: 3.5rem;
         font-weight: 800;
    color: white;
          line-height: 1.1;
     margin-bottom: 1.5rem;
        }
  
        .hero-title span {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
       background-clip: text;
        }
     
        .hero-description {
            font-size: 1.25rem;
    color: #94a3b8;
            max-width: 600px;
     margin-bottom: 2rem;
            line-height: 1.7;
        }
        
        .hero-actions {
      display: flex;
       gap: 1rem;
            flex-wrap: wrap;
        }
  
  .btn-hero-primary {
   display: inline-flex;
            align-items: center;
            justify-content: center;
            text-align: center;
 gap: 0.75rem;
          padding: 1rem 2rem;
 background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
         font-weight: 600;
  font-size: 1rem;
            border-radius: var(--radius-lg);
       text-decoration: none;
         transition: all var(--transition-normal);
       border: none;
        }
  
     .btn-hero-primary:hover {
      transform: translateY(-2px);
        box-shadow: 0 20px 40px rgba(59, 130, 246, 0.3);
color: white;
        }
   
        .btn-hero-secondary {
            display: inline-flex;
 align-items: center;
            justify-content: center;
            text-align: center;
        gap: 0.75rem;
         padding: 1rem 2rem;
       background: transparent;
      color: white;
 font-weight: 600;
            font-size: 1rem;
            border-radius: var(--radius-lg);
 text-decoration: none;
         border: 1px solid rgba(255, 255, 255, 0.2);
         transition: all var(--transition-normal);
        }
        
        .btn-hero-secondary:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.3);
          color: white;
     }
        
   .features-section {
            padding: 5rem 2rem;
            background: var(--bg-primary);
      }
        
        .features-grid {
     display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
     max-width: 1200px;
       margin: 0 auto;
        }
        
        .feature-card {
  background: var(--bg-card);
            border: 1px solid var(--border-color);
border-radius: var(--radius-xl);
      padding: 2rem;
            transition: all var(--transition-normal);
        }
        
      .feature-card:hover {
            transform: translateY(-4px);
       box-shadow: var(--shadow-xl);
        }

        .feature-icon {
    width: 56px;
      height: 56px;
            border-radius: var(--radius-lg);
 display: flex;
            align-items: center;
   justify-content: center;
font-size: 1.5rem;
            color: white;
  margin-bottom: 1.25rem;
    }
        
     .feature-title {
            font-size: 1.25rem;
            font-weight: 700;
 margin-bottom: 0.75rem;
        }
        
        .feature-description {
            color: var(--text-secondary);
            line-height: 1.6;
        }
     
    .stats-section {
          padding: 4rem 2rem;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
        }
  
        .stats-grid {
  display: grid;
   grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
       gap: 2rem;
            max-width: 1000px;
            margin: 0 auto;
text-align: center;
    }
 
        .stat-item {
    color: white;
        }
        
        .stat-value {
          font-size: 3rem;
            font-weight: 800;
            line-height: 1;
    margin-bottom: 0.5rem;
        }
        
        .stat-label {
        opacity: 0.9;
            font-size: 1rem;
        }
        
    @@media (max-width: 768px) {
            .hero-title {
                font-size: 2.5rem;
         }
            
  .hero-description {
      font-size: 1rem;
            }
            
            .hero-actions {
    flex-direction: column;
     }
     
        .btn-hero-primary,
      .btn-hero-secondary {
justify-content: center;
      }
        }
    </style>
}

<section class="hero-section">
    <div class="hero-content">
     <div class="hero-badge">
            <i class="fa-solid fa-shield-check"></i>
            Network Security Monitoring
        </div>
        <h1 class="hero-title">
       Intelligent <span>Intrusion Detection</span><br>
            For Modern Networks
        </h1>
        <p class="hero-description">
          Protect your infrastructure with advanced threat detection, real-time monitoring, 
 and comprehensive security analytics powered by machine learning.
        </p>
     <div class="hero-actions">
            @if (User?.Identity?.IsAuthenticated == true)
          {
                <a href="/Dashboard" class="btn-hero-primary">
    <i class="fa-solid fa-gauge"></i>
   Go to Dashboard
         </a>
            }
  else
     {
     <a href="/Identity/Account/Login" class="btn-hero-primary">
  <i class="fa-solid fa-right-to-bracket"></i>
      Sign In
                </a>
           <a href="/Help" class="btn-hero-secondary">
                    <i class="fa-solid fa-book-open"></i>
      Learn More
                </a>
  }
        </div>
    </div>
</section>

<section class="features-section">
    <div class="features-grid">
      <div class="feature-card">
    <div class="feature-icon gradient-blue">
     <i class="fa-solid fa-radar"></i>
     </div>
            <h3 class="feature-title">Real-Time Detection</h3>
            <p class="feature-description">
        Monitor network traffic in real-time with instant alerts for suspicious activities 
   and potential security threats.
            </p>
        </div>
  
        <div class="feature-card">
            <div class="feature-icon gradient-purple">
          <i class="fa-solid fa-brain"></i>
            </div>
  <h3 class="feature-title">ML-Powered Analysis</h3>
            <p class="feature-description">
    Leverage machine learning algorithms to detect complex attack patterns 
           and zero-day threats automatically.
        </p>
        </div>
        
 <div class="feature-card">
  <div class="feature-icon gradient-green">
    <i class="fa-solid fa-chart-line"></i>
            </div>
            <h3 class="feature-title">Comprehensive Dashboard</h3>
     <p class="feature-description">
      View detailed metrics, trends, and security insights through an intuitive 
            and professional dashboard interface.
            </p>
        </div>
  
        <div class="feature-card">
       <div class="feature-icon gradient-red">
             <i class="fa-solid fa-bell"></i>
      </div>
          <h3 class="feature-title">Smart Alerting</h3>
            <p class="feature-description">
     Receive prioritized alerts based on threat severity with actionable 
      recommendations for incident response.
            </p>
    </div>
        
        <div class="feature-card">
   <div class="feature-icon gradient-yellow">
        <i class="fa-solid fa-users-gear"></i>
     </div>
     <h3 class="feature-title">Role-Based Access</h3>
            <p class="feature-description">
        Secure multi-user environment with granular role-based permissions 
        for administrators and employees.
            </p>
 </div>
        
        <div class="feature-card">
            <div class="feature-icon gradient-cyan">
     <i class="fa-solid fa-file-export"></i>
            </div>
    <h3 class="feature-title">Audit & Reporting</h3>
            <p class="feature-description">
   Generate comprehensive audit logs and security reports for compliance 
      and forensic analysis.
       </p>
        </div>
    </div>
</section>

<section class="stats-section">
    <div class="stats-grid">
        <div class="stat-item">
 <div class="stat-value">99.9%</div>
            <div class="stat-label">Detection Accuracy</div>
        </div>
        <div class="stat-item">
     <div class="stat-value">&lt;1ms</div>
  <div class="stat-label">Response Time</div>
        </div>
      <div class="stat-item">
 <div class="stat-value">24/7</div>
    <div class="stat-label">Monitoring</div>
        </div>
    <div class="stat-item">
         <div class="stat-value">100+</div>
            <div class="stat-label">Attack Signatures</div>
        </div>
    </div>
</section>
