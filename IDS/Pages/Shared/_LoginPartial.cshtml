@using Microsoft.AspNetCore.Identity
@using IDS.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
 <div class="user-dropdown">
 <button id="userMenuToggle" class="user-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-label="User menu">
 <div class="bars"><span></span><span></span><span></span></div>
 </button>
 <div id="userMenu" class="dropdown-panel" style="display:none">
 <div class="panel-header">
 <div class="name">@User.Identity?.Name</div>
 <small class="text-muted">Account menu</small>
 </div>
 <nav class="panel-links">
 <a asp-area="Identity" asp-page="/Account/Manage/Index">Profile</a>
 <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword">Security</a>
 <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication">Two-Factor Auth</a>
 <a asp-area="Identity" asp-page="/Account/Manage/PersonalData">Personal Data</a>
 <a asp-area="Identity" asp-page="/Account/HelpSupport">Help & Support</a>
 <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" class="logout-form">
 <button type="submit" class="logout-btn">Logout</button>
 </form>
 </nav>
 </div>
 </div>
 <script>
 (function(){
 // User menu logic
 const trigger = document.getElementById('userMenuToggle');
 const panel = document.getElementById('userMenu');
 function positionPanel(){
 const r = trigger.getBoundingClientRect();
 panel.style.left = (r.right - panel.offsetWidth) + 'px';
 panel.style.top = (r.bottom +8) + 'px';
 }
 function open(){ panel.style.display='block'; panel.classList.add('open'); trigger.classList.add('active'); positionPanel(); }
 function close(){ panel.classList.remove('open'); panel.style.display='none'; trigger.classList.remove('active'); }
 trigger.addEventListener('click', ()=>{ panel.style.display==='block' ? close() : open(); });
 window.addEventListener('resize', ()=>{ if(panel.classList.contains('open')) positionPanel(); });
 document.addEventListener('scroll', ()=>{ if(panel.classList.contains('open')) positionPanel(); }, true);
 document.addEventListener('click', e=>{ if(!panel.contains(e.target) && !trigger.contains(e.target)) close(); });
 document.addEventListener('keydown', e=>{ if(e.key==='Escape') close(); });
 
 // Inactivity logout logic (testing:1 minute)
 const LIMIT_MS =60000; // match cookie ExpireTimeSpan for test
 let timer;
 function resetTimer(){
 clearTimeout(timer);
 timer = setTimeout(() => {
 window.location.href = '/Identity/Account/Logout?handler=Inactivity';
 }, LIMIT_MS);
 }
 ['click','mousemove','keydown','scroll','touchstart','touchmove'].forEach(evt => document.addEventListener(evt, resetTimer, { passive: true }));
 resetTimer();
 })();
 </script>
}
else
{
 <ul class="navbar-nav"><li class="nav-item"><a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login">Login</a></li></ul>
}
