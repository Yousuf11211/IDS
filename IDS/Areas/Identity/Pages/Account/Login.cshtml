@page
@model LoginModel

@{
    ViewData["Title"] = "Sign In";
    ViewData["NoContainer"] = true;
}

<div class="login-page">
    <div class="login-container">
    <div class="login-card">
       <div class="login-logo">
         <i class="fa-solid fa-shield-halved"></i>
     </div>
       <h1 class="login-title">Welcome Back</h1>
            <p class="login-subtitle">Sign in to access the IDS Security Dashboard</p>
      
        <form id="account" method="post">
   <div asp-validation-summary="ModelOnly" class="alert-ids alert-ids-danger mb-4" role="alert" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "flex" : "none")">
 <i class="alert-ids-icon fa-solid fa-circle-exclamation"></i>
   <div class="alert-ids-content"></div>
             </div>
           
 <div class="form-group">
     <label asp-for="Input.Email" class="form-label-ids">Email Address</label>
            <div class="input-group">
       <span class="input-group-text" style="background: var(--bg-tertiary); border-color: var(--border-color);">
     <i class="fa-solid fa-envelope text-muted"></i>
     </span>
        <input asp-for="Input.Email" class="form-control-ids" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" 
 autocomplete="username" aria-required="true" placeholder="you@example.com" />
   </div>
    <span asp-validation-for="Input.Email" class="form-error"></span>
         </div>
       
   <div class="form-group">
     <label asp-for="Input.Password" class="form-label-ids">Password</label>
    <div class="input-group">
        <span class="input-group-text" style="background: var(--bg-tertiary); border-color: var(--border-color);">
       <i class="fa-solid fa-lock text-muted"></i>
         </span>
   <input asp-for="Input.Password" class="form-control-ids" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" 
     type="password" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
          </div>
   <span asp-validation-for="Input.Password" class="form-error"></span>
     </div>
          
   <div class="d-flex justify-content-between align-items-center mb-4">
       <label asp-for="Input.RememberMe" class="form-label mb-0 d-flex align-items-center gap-2" style="cursor: pointer;">
       <input class="form-check-input" asp-for="Input.RememberMe" style="margin: 0;" />
<span style="font-size: 0.875rem;">Remember me</span>
         </label>
     <a asp-page="./ForgotPassword" class="text-primary" style="font-size: 0.875rem; text-decoration: none;">
 Forgot password?
          </a>
    </div>
 
        <button type="submit" class="btn-ids btn-ids-primary btn-ids-lg w-100">
 <i class="fa-solid fa-right-to-bracket me-2"></i> Sign In
      </button>
     </form>
            
  <div class="text-center mt-4">
         <a href="/" class="text-muted" style="font-size: 0.875rem; text-decoration: none;">
 <i class="fa-solid fa-arrow-left me-1"></i> Back to Home
       </a>
    </div>
   </div>
        
    <p class="text-center mt-4 text-muted" style="font-size: 0.8125rem;">
       Protected by IDS Security System
    </p>
 </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
