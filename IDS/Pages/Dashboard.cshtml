@page
@model IDS.Pages.DashboardModel
@{
 ViewData["Title"] = "Dashboard";
}

@section HeadContent {
    <style>
        .dashboard-hero {
   background: linear-gradient(135deg, var(--primary), var(--secondary));
     color: white;
    padding: 2rem;
 border-radius: var(--radius-xl);
          margin-bottom: 1.5rem;
position: relative;
       overflow: hidden;
        }
     
     .dashboard-hero::before {
   content: '';
position: absolute;
            top: 0;
       right: 0;
         width: 400px;
          height: 400px;
         background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
   transform: translate(30%, -30%);
    }
     
        .hero-content {
position: relative;
 z-index: 1;
 display: flex;
 justify-content: space-between;
     align-items: center;
   flex-wrap: wrap;
   gap: 1rem;
        }
        
        .hero-info h1 {
     font-size: 1.75rem;
     font-weight: 800;
   margin: 0 0 0.25rem 0;
         display: flex;
 align-items: center;
  gap: 0.75rem;
        }
   
        .hero-info p {
      opacity: 0.9;
            margin: 0;
        }
        
        .hero-actions {
            display: flex;
  align-items: center;
  gap: 1rem;
     }
 
        .time-display {
  background: rgba(255,255,255,0.15);
  padding: 0.5rem 1rem;
  border-radius: var(--radius-md);
    font-size: 0.875rem;
        }

        .ids-status-card {
    display: flex;
     align-items: center;
   gap: 1rem;
  padding: 1rem 1.5rem;
            background: var(--bg-card);
 border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
     box-shadow: var(--shadow-sm);
        }
        
     .status-indicator {
      width: 12px;
       height: 12px;
    border-radius: 50%;
   animation: pulse 2s infinite;
        }
        
        .status-indicator.normal { background: var(--success); }
      .status-indicator.attention { background: var(--warning); }
  .status-indicator.degraded { background: var(--danger); }
        
  @@keyframes pulse {
 0%, 100% { opacity: 1; transform: scale(1); }
   50% { opacity: 0.7; transform: scale(1.1); }
        }
  
   .status-text {
 font-weight: 700;
    font-size: 1rem;
        }
      
        .status-text.normal { color: var(--success); }
.status-text.attention { color: var(--warning); }
     .status-text.degraded { color: var(--danger); }
        
        .chart-container {
      height: 300px;
  background: var(--bg-card);
            border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
            padding: 1rem;
        }
        
        .recent-alerts-list {
            max-height: 350px;
         overflow-y: auto;
        }
   
   .alert-item {
          display: flex;
 align-items: flex-start;
    gap: 0.75rem;
         padding: 0.75rem;
         border-radius: var(--radius-md);
         transition: background var(--transition-fast);
     border-bottom: 1px solid var(--border-color);
        }
        
        .alert-item:last-child {
            border-bottom: none;
  }
        
        .alert-item:hover {
            background: var(--bg-tertiary);
        }
        
 .alert-severity {
   width: 8px;
            height: 8px;
      border-radius: 50%;
     margin-top: 6px;
   flex-shrink: 0;
        }
      
        .alert-severity.critical { background: var(--danger); }
     .alert-severity.high { background: #f97316; }
 .alert-severity.medium { background: var(--warning); }
   .alert-severity.low { background: var(--success); }
   
        .alert-content {
flex: 1;
       min-width: 0;
        }
    
        .alert-message {
    font-size: 0.875rem;
            color: var(--text-primary);
   white-space: nowrap;
 overflow: hidden;
     text-overflow: ellipsis;
        }
        
        .alert-meta {
   font-size: 0.75rem;
          color: var(--text-muted);
            display: flex;
     gap: 0.75rem;
         margin-top: 0.25rem;
   }
    </style>
}

<!-- Dashboard Hero -->
<div class="dashboard-hero">
    <div class="hero-content">
        <div class="hero-info">
      <h1>
   <i class="fa-solid fa-gauge"></i>
     Security Dashboard
            </h1>
<p>Real-time intrusion detection monitoring and analytics</p>
        </div>
   <div class="hero-actions">
    <div class="time-display" id="localTime">
 <i class="fa-solid fa-clock me-2"></i>
     <span id="timeValue">Loading...</span>
         </div>
        </div>
    </div>
</div>

<!-- Metrics Grid -->
<div class="metrics-grid mb-4">
    @if (User.IsInRole("Admin"))
 {
  <div class="metric-card" style="--metric-accent: var(--primary);">
   <div class="metric-icon gradient-blue">
   <i class="fa-solid fa-database"></i>
  </div>
     <div class="metric-content">
      <div class="metric-label">Total Activity Logs</div>
 <div class="metric-value">@Model.TotalLogs.ToString("N0")</div>
     </div>
 </div>
        <div class="metric-card" style="--metric-accent: var(--info);">
  <div class="metric-icon gradient-cyan">
      <i class="fa-solid fa-network-wired"></i>
      </div>
  <div class="metric-content">
<div class="metric-label">Network Events</div>
  <div class="metric-value">@Model.NetworkTotal.ToString("N0")</div>
          </div>
        </div>
    }
else
{
   <div class="metric-card" style="--metric-accent: var(--primary);">
      <div class="metric-icon gradient-blue">
       <i class="fa-solid fa-chart-simple"></i>
      </div>
     <div class="metric-content">
 <div class="metric-label">Total Events</div>
    <div class="metric-value">@Model.TotalLogs.ToString("N0")</div>
     </div>
        </div>
    }
    
    <div class="metric-card" style="--metric-accent: var(--success);">
        <div class="metric-icon gradient-green">
  <i class="fa-solid fa-shield-check"></i>
 </div>
     <div class="metric-content">
  <div class="metric-label">Normal Traffic</div>
   <div class="metric-value">@Model.NormalCount.ToString("N0")</div>
    </div>
    </div>
    
    <div class="metric-card" style="--metric-accent: var(--danger);">
   <div class="metric-icon gradient-red">
 <i class="fa-solid fa-skull-crossbones"></i>
        </div>
     <div class="metric-content">
 <div class="metric-label">Attacks Detected</div>
      <div class="metric-value">@Model.AttackCount.ToString("N0")</div>
        </div>
    </div>
</div>

<!-- Status and Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-lg-4">
        <div class="card-ids h-100">
    <div class="card-ids-header">
     <h3 class="card-ids-title">
     <i class="fa-solid fa-heart-pulse text-primary"></i>
   System Status
 </h3>
  </div>
 <div class="card-ids-body">
       <div class="ids-status-card">
    @{
          var statusClass = Model.IdsStatusClass switch
    {
          "on" => "normal",
"warn" => "attention",
"off" => "degraded",
    _ => "normal"
    };
        }
          <div class="status-indicator @statusClass"></div>
  <div>
        <div class="status-text @statusClass">@Model.IdsStatus</div>
         <div class="text-muted" style="font-size: 0.875rem;">IDS Protection Status</div>
    </div>
  </div>
   
     <div class="mt-4">
       <h4 style="font-size: 0.875rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.75rem;">TRAFFIC BREAKDOWN</h4>
      <div class="d-flex flex-column gap-2">
       @foreach (var level in Model.LevelCounts.OrderByDescending(x => x.Value).Take(5))
  {
   var percentage = Model.NetworkTotal > 0 ? (level.Value * 100.0 / Model.NetworkTotal) : 0;
   var color = level.Key switch
          {
         "Attacks Detected" => "var(--danger)",
    "Normal Traffic" => "var(--success)",
     _ => "var(--primary)"
        };
<div>
<div class="d-flex justify-content-between mb-1" style="font-size: 0.8125rem;">
    <span>@level.Key</span>
     <span class="text-muted">@level.Value</span>
    </div>
     <div style="height: 4px; background: var(--bg-tertiary); border-radius: 2px;">
<div style="height: 100%; width: @(percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%; background: @color; border-radius: 2px;"></div>
</div>
  </div>
       }
     </div>
    </div>
 </div>
        </div>
    </div>
    
    <div class="col-lg-8">
        <div class="card-ids h-100">
<div class="card-ids-header">
    <h3 class="card-ids-title">
 <i class="fa-solid fa-bolt text-warning"></i>
     Recent Activity
 </h3>
    @if (User.IsInRole("Admin"))
  {
    <a href="/Admin/Alerts" class="btn-ids btn-ids-ghost btn-ids-sm">
     View All <i class="fa-solid fa-arrow-right ms-1"></i>
          </a>
    }
   </div>
     <div class="card-ids-body p-0">
      <div class="recent-alerts-list" id="recentAlertsList">
<div class="p-4 text-center text-muted">
<i class="fa-solid fa-spinner fa-spin me-2"></i> Loading activity...
    </div>
     </div>
  </div>
        </div>
 </div>
</div>

@if (User.IsInRole("Admin"))
{
    <!-- Admin Logs Explorer -->
    <div class="card-ids">
   <div class="card-ids-header">
 <h3 class="card-ids-title">
  <i class="fa-solid fa-table-list text-info"></i>
   Logs Explorer
   </h3>
    <div class="d-flex gap-2">
   <div class="btn-group" role="group">
<button type="button" class="btn-ids btn-ids-secondary btn-ids-sm active" data-filter="all">All</button>
           <button type="button" class="btn-ids btn-ids-ghost btn-ids-sm" data-filter="information">Info</button>
<button type="button" class="btn-ids btn-ids-ghost btn-ids-sm" data-filter="normal">Normal</button>
         <button type="button" class="btn-ids btn-ids-ghost btn-ids-sm" data-filter="attack">Attack</button>
   </div>
 <a href="/Admin/Logs" class="btn-ids btn-ids-primary btn-ids-sm">
 <i class="fa-solid fa-external-link"></i> Full Logs
       </a>
 </div>
  </div>
        <div class="card-ids-body p-0">
  <div style="overflow-x: auto; max-height: 400px;">
     <table class="table-ids" id="logsTable">
        <thead style="position: sticky; top: 0;">
<tr>
 <th style="width: 180px;">Timestamp</th>
 <th style="width: 100px;">Level</th>
    <th style="width: 100px;">Class</th>
       <th>Message</th>
       <th style="width: 150px;">User</th>
   </tr>
  </thead>
   <tbody id="logsTableBody">
        <tr>
       <td colspan="5" class="text-center p-4">
    <i class="fa-solid fa-spinner fa-spin me-2"></i> Loading logs...
 </td>
    </tr>
</tbody>
 </table>
 </div>
        </div>
    </div>
}

@section Scripts {
    <script>
     (function() {
  // Update time display
      function updateTime() {
  const timeEl = document.getElementById('timeValue');
      if (timeEl) {
          timeEl.textContent = new Date().toLocaleString();
 }
     }
       updateTime();
   setInterval(updateTime, 1000);

 // Load recent activity
 async function loadRecentActivity() {
    const container = document.getElementById('recentAlertsList');
      try {
   const response = await fetch('?handler=RecentActivity');
        if (!response.ok) throw new Error('Failed to load activity');
  const data = await response.json();
  
    if (data.length === 0) {
     container.innerHTML = '<div class="empty-state py-4"><i class="fa-solid fa-check-circle text-success" style="font-size: 2rem;"></i><p class="mt-2 mb-0 text-muted">No recent activity</p></div>';
             return;
        }
      
         container.innerHTML = data.map(item => {
     const severity = item.severity?.toLowerCase();
     const severityClass = ['critical', 'high', 'medium', 'low'].includes(severity) ? severity : 'low';
     return `
        <div class="alert-item">
      <div class="alert-severity ${severityClass}"></div>
   <div class="alert-content">
  <div class="alert-message">${escapeHtml(item.message)}</div>
       <div class="alert-meta">
<span><i class="fa-solid fa-clock me-1"></i>${new Date(item.timestamp).toLocaleString()}</span>
<span><i class="fa-solid fa-tag me-1"></i>${escapeHtml(item.type || 'Activity')}</span>
         </div>
 </div>
    </div>
    `;
    }).join('');
    } catch (e) {
        container.innerHTML = '<div class="p-4 text-center text-danger">Failed to load activity</div>';
   }
      }
        loadRecentActivity();

  @if (User.IsInRole("Admin"))
       {
          <text>
  // Load logs for admin
let allLogs = [];
 
    async function loadLogs() {
  const tbody = document.getElementById('logsTableBody');
    try {
         const response = await fetch('?handler=Logs');
   if (!response.ok) throw new Error('Failed to load logs');
   allLogs = await response.json();
       renderLogs(allLogs);
         } catch (e) {
       tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger p-4">Failed to load logs</td></tr>';
 }
 }
          
       function renderLogs(data) {
   const tbody = document.getElementById('logsTableBody');
    if (data.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted p-4">No logs found</td></tr>';
      return;
   }
           
       tbody.innerHTML = data.slice(0, 100).map(log => {
  const levelClass = log.level === 'Error' ? 'severity-critical' : 
 log.level === 'Warning' ? 'severity-high' : 
 log.classification === 'Attack' ? 'severity-medium' : 'severity-info';
     const rowClass = log.level === 'Error' ? 'row-danger' : log.level === 'Warning' ? 'row-warning' : '';
       return `
          <tr class="${rowClass}">
      <td>${new Date(log.timestamp).toISOString().replace('T', ' ').substring(0, 19)}</td>
      <td><span class="severity-badge ${levelClass}">${log.level}</span></td>
   <td>${log.classification}</td>
 <td class="truncate" style="max-width: 400px;">${escapeHtml(log.message)}</td>
   <td>${log.userId || '-'}</td>
    </tr>
       `;
 }).join('');
      }
    
  // Filter buttons
   document.querySelectorAll('[data-filter]').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('[data-filter]').forEach(b => {
       b.classList.remove('active', 'btn-ids-secondary');
b.classList.add('btn-ids-ghost');
      });
   btn.classList.remove('btn-ids-ghost');
       btn.classList.add('active', 'btn-ids-secondary');
   
         const filter = btn.dataset.filter;
         const filtered = filter === 'all' ? allLogs :
         filter === 'information' ? allLogs.filter(l => l.level === 'Information') :
    filter === 'normal' ? allLogs.filter(l => l.classification === 'Normal') :
           filter === 'attack' ? allLogs.filter(l => l.classification === 'Attack') : allLogs;
          renderLogs(filtered);
      });
     });
          
            loadLogs();
    </text>
}

 function escapeHtml(text) {
            if (!text) return '';
   const div = document.createElement('div');
       div.textContent = text;
  return div.innerHTML;
            }
        })();
    </script>
}