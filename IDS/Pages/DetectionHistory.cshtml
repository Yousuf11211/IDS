@page
@model IDS.Pages.DetectionHistoryModel
@{
    ViewData["Title"] = "Detection history";
}
<header class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">Detection history</h1>
    <a asp-page="/LiveDashboard" class="btn-ids btn-ids-secondary">Live Feed</a>
</header>
@if (Model.Selected is { } alert)
{
    <section class="card-ids card-ids-body mb-3">
        <h2 class="h5">@alert.Type</h2>
        <p class="text-break mb-2">@alert.Severity · @alert.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC · @alert.Source · Port @(alert.Port?.ToString() ?? "Unavailable")</p>
        <div class="d-flex gap-2 flex-wrap">
            @if (User.IsInRole("Admin") || User.IsInRole("Support"))
            {
                <a asp-page="/InspectAttack" asp-route-id="@alert.Id" class="btn-ids btn-ids-secondary">Inspect detection</a>
            }
            @if (Model.EscalationEnabled && (alert.Severity is "High" or "Critical"))
            {
                <a asp-page="/EscalateAttack" asp-route-id="@alert.Id" class="btn-ids btn-ids-primary">Escalate incident</a>
            }
        </div>
    </section>
}
<div class="card-ids table-responsive">
    <table class="table-ids">
        <thead><tr><th>Detected (UTC)</th><th>Attack type</th><th>Severity</th><th>Source</th><th>Destination port</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Alerts)
        {
            <tr>
                <td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td><a asp-route-id="@item.Id" asp-route-p="@Model.CurrentPage">@item.Type</a></td>
                <td>@item.Severity</td>
                <td>@item.Source</td>
                <td>@(item.Port?.ToString() ?? "—")</td>
            </tr>
        }
        @if (Model.Alerts.Count == 0)
        {
            <tr><td colspan="5" class="text-muted">No attacks recorded on this page.</td></tr>
        }
        </tbody>
    </table>
</div>
<nav class="d-flex gap-2 mt-3" aria-label="Detection history pages">
    @if (Model.CurrentPage > 1)
    {
        <a asp-route-p="@(Model.CurrentPage - 1)" class="btn-ids btn-ids-secondary">Previous</a>
    }
    @if (Model.HasNext)
    {
        <a asp-route-p="@(Model.CurrentPage + 1)" class="btn-ids btn-ids-secondary">Next</a>
    }
</nav>
