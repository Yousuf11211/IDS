@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
    ViewData["NoContainer"] = true;
}

<div class="login-page">
    <div class="login-container">
      <div class="login-card">
            <div class="login-logo">
        <i class="fa-solid fa-shield-halved"></i>
       </div>
    <h1 class="login-title">Two-Factor Authentication</h1>
            <p class="login-subtitle">Your account is protected with 2FA. Enter the code from your authenticator app.</p>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
         <input asp-for="RememberMe" type="hidden" />
         <div asp-validation-summary="ModelOnly" class="alert-ids alert-ids-danger mb-3" role="alert"></div>

        <div class="form-group">
         <label asp-for="Input.TwoFactorCode" class="form-label-ids">Authenticator Code</label>
    <input asp-for="Input.TwoFactorCode" class="form-control-ids text-center" 
     style="font-size: 1.5rem; letter-spacing: 0.5rem; font-family: monospace;" 
  autocomplete="off" 
 placeholder="000000"
         maxlength="7" />
       <span asp-validation-for="Input.TwoFactorCode" class="form-error"></span>
       </div>

          <div class="form-check mb-4">
            <input asp-for="Input.RememberMachine" class="form-check-input" />
         <label asp-for="Input.RememberMachine" class="form-check-label">
      Don't ask again on this device
    </label>
       </div>

       <button type="submit" class="btn-ids btn-ids-primary btn-ids-lg w-100">
   <i class="fa-solid fa-unlock me-2"></i> Verify & Sign In
          </button>
      </form>
        </div>

   <div class="card-ids mt-4">
       <div class="card-ids-body text-center">
     <p class="mb-2 text-muted">Don't have access to your authenticator?</p>
           <a asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="btn-ids btn-ids-secondary">
                <i class="fa-solid fa-key me-2"></i> Use Recovery Code
 </a>
            </div>
      </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}