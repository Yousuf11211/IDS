@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>
<div class="row">
    <div class="col-md-8">
        <div class="alert alert-warning">
            Your account contains personal data you have provided. You can download a copy of this data.
        </div>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-outline-primary" type="submit">Download Personal Data</button>
        </form>
        <p class="mt-3 text-muted">Account deletion has been disabled by the administrator.</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
