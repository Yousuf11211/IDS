@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    ViewData["NoContainer"] = true;
}

<div class="login-page" style="background: var(--bg-primary);">
 <div class="login-container" style="max-width: 500px;">
   <div class="card-ids text-center">
     <div class="card-ids-body py-5">
        <div class="mb-4">
       <i class="fa-solid fa-triangle-exclamation" style="font-size: 4rem; color: var(--danger);"></i>
  </div>
      <h1 class="h3 mb-3">Something went wrong</h1>
       <p class="text-muted mb-4">
  An error occurred while processing your request.
     </p>
   
@if (Model.ShowRequestId)
                {
  <div class="alert-ids alert-ids-info mb-4">
      <i class="alert-ids-icon fa-solid fa-info-circle"></i>
     <div class="alert-ids-content">
   <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
</div>
  }
       
       <div class="d-flex gap-3 justify-content-center">
 <a href="/" class="btn-ids btn-ids-primary">
     <i class="fa-solid fa-home me-2"></i> Go Home
           </a>
   <a href="/Help" class="btn-ids btn-ids-secondary">
      <i class="fa-solid fa-arrow-left me-2"></i> Help &amp; Support
      </a>
    </div>
   </div>
     </div>
 
  <div class="card-ids mt-4">
       <div class="card-ids-body">
   <h4 style="font-size: 1rem; margin-bottom: 0.5rem;">Need Help?</h4>
     <p class="text-muted mb-0" style="font-size: 0.875rem;">
          If this problem persists, please contact your system administrator 
       or visit the <a href="/Help">Help & Support</a> page.
        </p>
     </div>
   </div>
  </div>
</div>
