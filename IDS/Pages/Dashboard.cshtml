@page
@model IDS.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["FullWidthLayout"] = true; @* Keeps the page edge-to-edge *@
}

@section HeadContent {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
}

@* The dashboard-container and sidebar are removed. Main content takes full width. *@
<main class="dashboard-main-content">

    <header class="dashboard-header">
        <h1>Overview</h1>
        <div class="user-info">
            @* Dynamic User Name *@
            <span id="welcome-user">Welcome, @User.Identity.Name!</span>
            <i class="fas fa-bell"></i>
        </div>
    </header>

    @* Analysis Control (Retained for future IDS logic) *@
    @* Analysis Control (Updated to be an actual form) *@
    <section class="analysis-control">
        <h2>Real-Time Analysis Input</h2>

        @* Display Status Message (from the C# code-behind) *@
        @if (!string.IsNullOrEmpty(Model.AnalysisStatusMessage))
        {
            <div class="alert alert-info">@Model.AnalysisStatusMessage</div>
        }

        @* Form to upload and run analysis *@
        <form method="post" asp-page-handler="UploadAndAnalyze" enctype="multipart/form-data">
            <div class="input-group">
                @* The asp-for tag helper links the file input to the C# property in Dashboard.cshtml.cs *@
                <label for="TrafficCsvFile">Select Traffic Log (CSV)</label>
                <input type="file" asp-for="TrafficCsvFile" id="TrafficCsvFile" accept=".csv" required />
                <button type="submit" id="start-analysis-btn">Start Analysis</button>
            </div>
        </form>

    </section>

    @* METRICS GRID: Visible only to Admin users *@
    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        <section class="metrics-grid">
            <div class="metric-card primary">
                <i class="fas fa-bug icon"></i>
                <p class="label">Total Logs Recorded</p>
                <p class="value" id="total-attacks">@Model.TotalLogs</p>
            </div>
            <div class="metric-card danger">
                <i class="fas fa-fire icon"></i>
                <p class="label">Critical Logs</p>
                <p class="value" id="highest-severity">@(Model.LevelCounts.TryGetValue("Error", out int criticalCount) ? criticalCount.ToString() : (Model.LevelCounts.TryGetValue("Warning", out int warningCount) ? warningCount.ToString() : "0"))</p>
            </div>
            <div class="metric-card info">
                <i class="fas fa-network-wired icon"></i>
                <p class="label">Information Logs</p>
                <p class="value" id="traffic-volume">@(Model.LevelCounts.TryGetValue("Information", out int infoCount) ? infoCount.ToString() : "0")</p>
            </div>
            <div class="metric-card danger">
                @* Changed from 'success' to 'danger' to match the warning color theme *@
                <i class="fas fa-exclamation-triangle icon"></i> @* Changed icon from check-circle to exclamation-triangle *@
                <p class="label">IDS Status</p>
                <p class="value" id="system-status">Non-Operational</p> @* Changed text to Non-Operational *@
            </div>
        </section>
    }
    else
    {
        <p class="text-muted">Welcome to the IDS Dashboard. System metrics are available to Administrators.</p>
    }


    @* VISUALIZATION AND LOGS: Use existing AJAX logic *@
    <section class="visualization-area">
        <div class="chart-panel chart-full">
            <h2>Attack Types Breakdown</h2>
            <div class="chart-container" style="position: relative; height:40vh; width:100%">
                <canvas id="attackTypeChart"></canvas>
            </div>
        </div>
        <div class="chart-panel recent-alerts">
            <h2>Recent System Logs</h2>
            <table id="alerts-table">
                <thead>
                    <tr>
                        <th>Time (UTC)</th>
                        <th>Level</th>
                        <th>Message</th>
                        <th>User ID</th>
                    </tr>
                </thead>
                <tbody id="alerts-table-body">
                    <tr><td colspan="4" class="no-data">System logs load when the corresponding header link is clicked.</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <div id="dashboard-content" style="display:none;"></div>

</main>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script>
        (function() {
            // NOTE: The previous script relied on a sidebar link with a specific icon.
            // You will need to map this function to the new 'Alerts Log' link you add in your header (_Layout.cshtml).
            const logLoader = async function() {
                const tableBody = document.getElementById('alerts-table-body');
                tableBody.innerHTML = '<tr><td colspan="4" class="no-data">Loading logs...</td></tr>';

                const res = await fetch('?handler=GetLogs');
                if (!res.ok) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="no-data text-danger">Failed to load logs</td></tr>';
                    return;
                }
                const logs = await res.json();
                if (!logs || logs.length === 0) {
                    tableBody.innerHTML = '<tr><td colspan="4" class="no-data">No logs found.</td></tr>';
                    return;
                }

                let html = '';
                for (const l of logs) {
                    let levelClass = '';
                    if (l.level === 'Error') levelClass = 'severity-critical';
                    else if (l.level === 'Warning') levelClass = 'severity-medium';

                    html += `<tr>
                                <td>${new Date(l.timestamp).toISOString().replace('T',' ').substr(0,19)}</td>
                                <td class="${levelClass}">${l.level}</td>
                                <td>${l.message}</td>
                                <td>${l.userId || ''}</td>
                            </tr>`;
                }
                tableBody.innerHTML = html;
            };

            // You can manually call the logLoader function here for initial data load, or map it to a button.
            // Example: To load logs instantly for Admins:
            // if ('@User.IsInRole("Admin")' === 'True') {
            //     logLoader();
            // }


            // Basic Chart.js initialization (Still using placeholder data)
            const ctx = document.getElementById('attackTypeChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Brute Force', 'SQL Injection', 'DDoS', 'XSS'],
                        datasets: [{
                            label: 'Attacks',
                            data: [12, 3, 5, 2],
                            backgroundColor: [
                                '#e74c3c',
                                '#f39c12',
                                '#3498db',
                                '#2ecc71'
                            ],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            }
        })();
    </script>
}