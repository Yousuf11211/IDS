@using Microsoft.AspNetCore.Identity
@using IDS.Data.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IDS.Security.SecurityPolicyService SecurityPolicies

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var userRoles = currentUser == null ? new List<string>() : await UserManager.GetRolesAsync(currentUser);
    var primaryRole = userRoles.FirstOrDefault() ?? "User";
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FirstName)
        ? currentUser.FirstName
        : currentUser?.Email?.Split('@')[0] ?? "Account";
    if (string.IsNullOrWhiteSpace(displayName)) displayName = "Account";
    var initials = displayName[..1].ToUpperInvariant();
    var needsPassword = currentUser?.MustChangePassword == true;
    var testingBypass = currentUser != null && await SecurityPolicies.CanBypassTwoFactorAsync(currentUser);
    var needsAuthenticator = currentUser != null && !testingBypass && !await UserManager.GetTwoFactorEnabledAsync(currentUser);
    var pendingCount = (needsPassword ? 1 : 0) + (needsAuthenticator ? 1 : 0);

    <div class="user-dropdown">
        @if (testingBypass)
        {
            <span class="badge bg-warning text-dark me-2">Testing: 2FA bypassed</span>
        }
        <button id="userMenuToggle" class="user-trigger" type="button" aria-haspopup="true" aria-expanded="false"
                aria-controls="userMenu" aria-label="Account menu@(pendingCount > 0 ? $", {pendingCount} setup steps pending" : string.Empty)">
            <div class="user-avatar">@initials</div>
            <div class="user-info d-none d-md-block">
                <div class="user-name">@displayName</div>
                <div class="user-role">@primaryRole</div>
            </div>
            @if (pendingCount > 0)
            {
                <span class="badge rounded-pill bg-warning text-dark ms-2" title="@pendingCount account setup step(s) pending">
                    @pendingCount pending
                </span>
            }
            <i class="fa-solid fa-chevron-down ms-2" aria-hidden="true"></i>
        </button>

        <div id="userMenu" class="dropdown-panel">
            <div class="dropdown-header">
                <div class="user-name">@displayName</div>
                <div class="text-muted" style="font-size: 0.8125rem;">@currentUser?.Email</div>
            </div>

            @if (pendingCount > 0)
            {
                <div class="px-3 py-2" role="status">
                    <div class="fw-semibold text-warning mb-1">Account setup pending</div>
                    <div class="text-muted small">Complete @pendingCount remaining security step@(pendingCount == 1 ? "" : "s") to access your workspace.</div>
                    <a asp-area="Identity"
                       asp-page="@(needsPassword ? "/Account/FirstTimeSetup" : "/Account/Manage/EnableAuthenticator")"
                       class="btn-ids btn-ids-primary w-100 mt-2 d-flex align-items-center justify-content-center gap-2">
                        <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                        <span>Continue setup</span>
                    </a>
                </div>
                <div class="dropdown-divider"></div>
            }

            <nav class="dropdown-links" aria-label="Account">
                <a asp-area="Identity" asp-page="/Account/Manage/Index" class="dropdown-link">
                    <i class="fa-solid fa-user" aria-hidden="true"></i> Profile
                </a>
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="dropdown-link">
                    <i class="fa-solid fa-key" aria-hidden="true"></i> Change password
                </a>
                <a asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication" class="dropdown-link">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Two-factor authentication
                </a>
                <div class="dropdown-divider"></div>
                <a asp-area="Identity" asp-page="/Account/Manage/PersonalData" class="dropdown-link">
                    <i class="fa-solid fa-download" aria-hidden="true"></i> Personal data
                </a>
                <a asp-page="/Help" class="dropdown-link">
                    <i class="fa-solid fa-circle-question" aria-hidden="true"></i> Help and support
                </a>
            </nav>

            <div class="dropdown-footer">
                <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                    <button type="submit" class="btn-logout d-flex align-items-center justify-content-center gap-2 w-100">
                        <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Sign out
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        (() => {
            const trigger = document.getElementById('userMenuToggle');
            const panel = document.getElementById('userMenu');
            if (!trigger || !panel) return;

            const closeMenu = () => {
                panel.classList.remove('open');
                trigger.setAttribute('aria-expanded', 'false');
            };

            trigger.addEventListener('click', event => {
                event.stopPropagation();
                const isOpen = panel.classList.toggle('open');
                trigger.setAttribute('aria-expanded', String(isOpen));
            });
            document.addEventListener('click', event => {
                if (!panel.contains(event.target) && !trigger.contains(event.target)) closeMenu();
            });
            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') closeMenu();
            });

            // The client timer mirrors the server's 30-minute authentication cookie lifetime.
            const inactivityTimeoutMs = 30 * 60 * 1000;
            let inactivityTimer;
            const resetInactivityTimer = () => {
                clearTimeout(inactivityTimer);
                inactivityTimer = setTimeout(() => {
                    window.location.href = '/Identity/Account/Logout?handler=Inactivity';
                }, inactivityTimeoutMs);
            };
            ['click', 'mousemove', 'keydown', 'scroll', 'touchstart'].forEach(eventName => {
                document.addEventListener(eventName, resetInactivityTimer, { passive: true });
            });
            resetInactivityTimer();
        })();
    </script>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Login" class="btn-ids btn-ids-primary d-inline-flex align-items-center justify-content-center gap-2">
        <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i> Sign in
    </a>
}
