@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check your email";
}
<section class="card-ids card-ids-body mx-auto" style="max-width: 36rem">
    <h1 class="h3">Check your email</h1>
    <p>If the address is eligible for self-service recovery, IDS will send a password reset link. Contact support if you need help.</p>
    <a asp-page="./Login">Back to sign in</a>
</section>
